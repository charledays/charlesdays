---
/* ABOUT — kept simple, presented like a gallery: one portrait hung large
   with the short bio as its wall text, then Charles at work across
   projects (one gallery wall, each photo labelled with its project and
   linking to it in the viewer), then the four sections as image doors.
   Bio copy and links are the existing ones, unchanged. */
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import GalleryRow from '../../components/GalleryRow.astro';
import Viewer from '../../components/Viewer.astro';
import { smSrc, sizeOf } from '../../lib/media';
import '../../styles/gallery.css';

const PORTRAIT = { src: '/images/stories/interlock/detail-01.jpg', alt: 'Charles Days de pie frente al mural, trabajando en él, visto principalmente desde atrás' };
const [pw, ph] = sizeOf(PORTRAIT.src);

const AT_WORK = [
  { src: '/images/stories/art/cover.jpg', alt: 'Charles Days de pie frente a un muro texturizado, sosteniendo la obra frente a él', caption: 'Caos Tipográfico', link: '/projects/art/', linkLabel: 'Ver proyecto' },
  { src: '/images/stories/interlock/detail-02.jpg', alt: 'Charles Days sentado en el piso trabajando en el mural', caption: 'Interlock', link: '/projects/interlock/', linkLabel: 'Ver proyecto' },
  { src: '/images/stories/highend-night-car-meet/detail-01.jpeg', alt: 'Charles Days trabajando de cerca sobre el auto con el marcador amarillo', caption: 'Highend — Night Car Meet', link: '/projects/highend-night-car-meet/', linkLabel: 'Ver proyecto' },
  { src: '/images/stories/reflections/detail-01.png', alt: 'Charles Days pintando directamente sobre el espejo con un marcador blanco', caption: 'Reflections', link: '/projects/reflections/', linkLabel: 'Ver proyecto' },
  { src: '/images/stories/mr-enz-x-charles-days/cover.jpg', alt: 'MR ENZ y Charles Days interviniendo una prenda negra con bleach', caption: 'MR ENZ × Charles Days', link: '/projects/mr-enz-x-charles-days/', linkLabel: 'Ver proyecto' },
  { src: '/images/stories/new-yorker-85/detail-05.jpg', alt: 'Charles Days de pie frente al New Yorker amarillo intervenido', caption: "New Yorker 85'", link: '/projects/new-yorker-85/', linkLabel: 'Ver proyecto' },
  { src: '/images/manifiesto/process-cutting.jpg', alt: 'Charles Days trabajando sobre una superficie de espejo con caligrafía blanca', caption: 'Manifiesto', link: '/exhibitions/manifiesto/', linkLabel: 'Ver exposición' },
];

const DOORS = [
  { href: '/projects/', label: 'PROJECTS', src: '/images/stories/interlock/cover.jpg' },
  { href: '/film/', label: 'FILM & PHOTO', src: '/images/wall/avirex.png' },
  { href: '/tattoo/', label: 'TATTOO', src: '/images/wall/tattoo-neck-sky.jpg' },
  { href: '/exhibitions/', label: 'EXHIBITIONS', src: '/images/manifiesto/gallery-wall.jpg' },
];
---
<Base>
  <PageHead
    slot="head"
    title="About — Charles Days, Visual Alchemist"
    description="Charles Days — creative director y visual alchemist en Lima. +10 años construyendo universos visuales para marcas, artistas y proyectos."
    image={PORTRAIT.src}
    imageAlt={PORTRAIT.alt}
  />

  <main class="g-page">
    <section class="ab-hero g-wrap">
      <button type="button" class="ab-portrait" data-view="retrato" data-full={PORTRAIT.src} data-sm={smSrc(PORTRAIT.src)} data-caption="Charles Days — Interlock" aria-label="Ver retrato">
        <img src={smSrc(PORTRAIT.src)} alt={PORTRAIT.alt} width={pw} height={ph} fetchpriority="high" decoding="async" />
      </button>
      <div class="ab-text">
        <p class="g-kicker">Sobre mí</p>
        <h1 class="ab-title">VISUAL<br />ALCHEMIST</h1>
        <div class="ab-bio">
          <p>¿Has oído hablar de un Visual Alchemist?</p>
          <p>Yo tampoco.</p>
          <p>Pero probablemente es el término que mejor define lo que hago.</p>
          <p class="ab-small">+10 años creando, experimentando y haciendo side quests en distintos formatos. Hoy uso todo eso para construir universos visuales para marcas, artistas y proyectos.</p>
        </div>
        <div class="ab-links">
          <a class="g-link" href="https://www.youtube.com/watch?v=Pl3LlSB1sKU&t=1014s" target="_blank" rel="noopener noreferrer">Ver entrevista ↗</a>
          <a class="g-link" href="https://www.instagram.com/charlesdays.art" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
        </div>
      </div>
    </section>

    <GalleryRow id="estudio" kicker="Charles en el trabajo" title="EN EL ESTUDIO" items={AT_WORK} size="md" />

    <section class="ab-doors g-wrap" aria-label="Secciones">
      {DOORS.map((d) => (
        <a class="ab-door" href={d.href}>
          <img src={smSrc(d.src)} alt="" loading="lazy" decoding="async" />
          <span>{d.label} &rarr;</span>
        </a>
      ))}
    </section>

    <footer class="g-foot g-wrap">
      <span>Charles Days · Lima, Perú</span>
      <span>Art Direction · Tattoo · Film · Visual Art</span>
    </footer>
  </main>

  <Viewer />
</Base>

<style>
  .ab-hero{display:grid;gap:2rem;align-items:center;margin-bottom:clamp(4rem,9vw,7rem);}
  @media (min-width:900px){.ab-hero{grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:5vw;min-height:calc(100svh - var(--nav-h) - 2rem);}}
  .ab-portrait{display:block;padding:0;border:0;background:#111;cursor:zoom-in;max-height:calc(100svh - var(--nav-h) - 3rem);overflow:hidden;}
  .ab-portrait img{width:100%;height:100%;object-fit:cover;}
  .ab-portrait:focus-visible{outline:2px solid rgba(255,255,255,0.9);outline-offset:3px;}
  .ab-title{margin-top:0.8rem;font-family:var(--font-display);font-weight:700;font-size:clamp(3rem,8.5vw,7.5rem);letter-spacing:-0.04em;line-height:0.86;}
  .ab-bio{margin-top:1.8rem;max-width:30rem;font-size:clamp(1.02rem,1.4vw,1.25rem);line-height:1.5;font-weight:300;}
  .ab-bio p + p{margin-top:0.5rem;}
  .ab-bio .ab-small{margin-top:1.2rem;font-size:0.88rem;line-height:1.7;color:#bdb9b2;}
  .ab-links{display:flex;flex-wrap:wrap;gap:1.6rem;margin-top:2rem;}

  .ab-doors{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;}
  @media (min-width:900px){.ab-doors{grid-template-columns:repeat(4,1fr);gap:10px;}}
  .ab-door{position:relative;display:block;aspect-ratio:3/4;overflow:hidden;text-decoration:none;background:#111;}
  .ab-door img{position:absolute;left:0;top:0;width:100%;height:112%;object-fit:cover;filter:brightness(.6);transition:transform 1.6s cubic-bezier(.25,.1,.25,1),filter .5s ease;}
  .ab-door span{position:absolute;left:1rem;bottom:0.9rem;font-family:var(--font-display);font-weight:700;font-size:clamp(0.95rem,1.6vw,1.3rem);letter-spacing:0.01em;}
  @media (hover:hover){.ab-door:hover img{transform:translateY(-10%);filter:brightness(.85);}}
  .ab-door:focus-visible{outline:2px solid rgba(255,255,255,0.9);outline-offset:3px;}
  @media (prefers-reduced-motion:reduce){.ab-door img{transition:none;}}
</style>
