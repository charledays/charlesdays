  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://charlesdays.art/#charles-days",
  "name": "Charles Days",
  "jobTitle": "Tatuador",
  "url": "https://charlesdays.art/tattoo/",
  "image": "https://charlesdays.art/images/wall/tattoo-neck-sky.jpg",
  "telephone": "+51923386692",
  "knowsAbout": ["Realismo black and grey", "Ornamental black and red", "Lettering", "Dark lettering", "Fineline", "Tatuaje"],
  "areaServed": [
    { "@type": "Place", "name": "Santiago de Surco, Lima, Perú" },
    { "@type": "Place", "name": "Miraflores, Lima, Perú" }
  ],
  "sameAs": [
    "https://www.instagram.com/charlesdays.art",
    "https://www.tiktok.com/@charlesdayss"
  ]
}
