<style is:inline>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&family=Space+Grotesk:wght@500;700&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#000;--text:#f5f2ed;--text-muted:#9aa4c2;--hair:rgba(245,242,237,0.12);--hair-strong:rgba(245,242,237,0.28);
  --font-display:'Space Grotesk', sans-serif;
}
html{background:var(--bg);overflow-x:clip;}
html,body{color:var(--text);font-family:'DM Sans',sans-serif;}
/* overflow-x:clip, not hidden, and only on html — any non-visible
   *overflow* value (on either html or body) forces the other axis to
   compute to "auto", turning that element into its own scroll
   container, which silently breaks position:sticky on this page's side
   columns further down. `clip` blocks horizontal overflow the same way
   without that side effect. */

.tattoo-page{padding-top:var(--nav-h);}

/* ===== Tattoo page — dark, image-first. A short header (title, styles,
   two actions), a full-width masonry gallery that shows every photo
   uncropped, then a visual quote builder that hands off to WhatsApp.
   Photos open in the same blurred pop-out as the Wall (HD original
   swapped in once loaded). ===== */
.tt-wrap{width:min(100% - 2 * var(--gutter),var(--container));margin:0 auto;}

/* Corners: photos are square; tags, buttons, the form and the viewer
   controls share one small 4–6px radius — no pills, no hard boxes. */

/* --- header: same kicker + big title as every section (/assets/nav.css),
   then the styles as square tags and two square actions --- */
.tt-head .tt-title{font-size:clamp(2.4rem,5.5vw,5rem);line-height:1.02;overflow-wrap:break-word;}
.tt-title span{font-size:.65em;}
.tt-intro{max-width:62ch;margin-top:1.2rem;font-size:.95rem;line-height:1.7;color:#d6d3cd;}
.tt-info{padding:3rem 0;border-bottom:1px solid var(--hair);}
.tt-info h2{font-family:var(--font-display);font-size:clamp(1.5rem,3vw,2.2rem);margin-bottom:1.2rem;}
.tt-info h3{font-size:1rem;margin-bottom:.5rem;}
.tt-info p{max-width:68ch;color:#d6d3cd;line-height:1.75;font-size:.95rem;}
.tt-info-grid{display:grid;gap:1.7rem;}
@media(min-width:900px){.tt-info-grid{grid-template-columns:1fr 1fr;}}
.tt-info details{padding:1rem 0;border-top:1px solid var(--hair);}
.tt-info summary{cursor:pointer;line-height:1.5;font-weight:500;}
.tt-info details p{margin-top:.7rem;}
.tt-info .tt-btn{margin-top:1.5rem;}
.tt-head{display:grid;gap:1.6rem;padding-bottom:1.8rem;}
.tt-styles{display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:1.4rem;}
.tt-style{text-decoration:none;font-size:0.68rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--text);border:1px solid var(--hair-strong);border-radius:4px;padding:0.55rem 0.85rem;}
.tt-style:hover,.tt-style:focus-visible{background:var(--text);color:#000;}
.tt-style:focus-visible{outline:2px solid var(--text);outline-offset:3px;}
.tt-style b{font-weight:500;color:#e2312d;}
.tt-actions{display:flex;flex-wrap:wrap;gap:0.6rem;align-items:stretch;}
.tt-btn{display:inline-flex;align-items:center;gap:0.6em;font-size:0.7rem;font-weight:500;letter-spacing:0.16em;text-transform:uppercase;text-decoration:none;padding:1rem 1.4rem;border:1px solid var(--text);border-radius:4px;transition:background .2s ease,color .2s ease;}
.tt-btn-solid{background:var(--text);color:#0b0b0b;}
.tt-btn-solid:hover{background:transparent;color:var(--text);}
.tt-btn-ghost{color:var(--text);border-color:var(--hair-strong);}
.tt-btn-ghost:hover{background:var(--text);color:#0b0b0b;}
.tt-btn:focus-visible{outline:2px solid rgba(255,255,255,0.9);outline-offset:3px;}
.ext-icon{width:13px;height:13px;flex-shrink:0;}
@media (min-width:900px){
  .tt-head{grid-template-columns:1fr auto;align-items:end;}
}

/* --- gallery: CSS columns masonry, every photo at its own aspect ratio
   (width/height attributes reserve the space, so nothing jumps while the
   lazy images arrive). Square corners. No zoom and no caption on hover —
   the photo just brightens.
   Pinterest-style: the column count follows the viewport (2 on phones,
   then as many ~210px columns as fit the content width). --- */
.tt-gallery-heading{padding:1.5rem 0;}
.tt-gallery-heading h2{font-family:var(--font-display);font-size:clamp(1.5rem,3vw,2.2rem);margin:.7rem 0;}
.tt-gallery-heading>p:last-child{color:#d6d3cd;max-width:65ch;line-height:1.6;font-size:.9rem;}
.tt-work{break-inside:avoid;margin:0 0 1rem;}
.tt-work figcaption{padding:.5rem .35rem;font-size:.75rem;line-height:1.5;color:#b8bdc9;}
.tt-style-info{scroll-margin-top:calc(var(--nav-h) + 1.5rem);}
.tt-gallery{columns:2;column-gap:6px;padding:0 6px;}
@media (min-width:600px){.tt-gallery{columns:210px;width:min(100% - 2 * var(--gutter),var(--container));margin:0 auto;padding:0;}}
.tt-photo{position:relative;display:block;width:100%;margin:0 0 6px;break-inside:avoid;overflow:hidden;background:#111;cursor:zoom-in;border:0;padding:0;}
.tt-photo img{display:block;width:100%;height:auto;filter:brightness(.88);transition:filter .45s ease;}
@media (hover:hover){.tt-photo:hover img{filter:brightness(1);}}
.tt-photo:focus-visible{outline:2px solid rgba(255,255,255,0.9);outline-offset:-2px;}

/* Direct contact after the portfolio: one native link, no form or JavaScript. */
.tt-quote{scroll-margin-top:calc(var(--nav-h) + 1rem);position:relative;margin-top:2rem;overflow:hidden;isolation:isolate;border-top:1px solid var(--hair);border-bottom:1px solid var(--hair);}
.tt-quote-bg{position:absolute;inset:0;z-index:-1;}
.tt-quote-bg img{width:100%;height:100%;object-fit:cover;object-position:75% 50%;filter:brightness(.35);}
.tt-quote-bg::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.25),rgba(0,0,0,.8));}
.tt-quote-inner{display:grid;gap:1.5rem;padding:2.5rem 0;}
.tt-quote-inner .g-kicker{margin-bottom:.8rem;}
.tt-quote-h{font-family:var(--font-display);font-weight:700;font-size:clamp(1.8rem,4vw,3rem);letter-spacing:-.03em;line-height:1.05;}
.tt-quote-p{margin-top:.9rem;max-width:40rem;font-size:.95rem;line-height:1.6;color:#d6d3cd;}
.tt-quote-inner>.tt-btn{justify-self:start;}
@media(min-width:900px){.tt-quote-inner{grid-template-columns:1fr auto;align-items:center;gap:3rem;}}

.tt-foot{padding:4rem 0 3rem;display:flex;justify-content:space-between;gap:1rem;font-size:0.62rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--text-muted);}

/* --- pop-out viewer (same treatment as the Wall's) --- */
.viewer{position:fixed;inset:0;z-index:200;display:flex;flex-direction:column;background:rgba(0,0,0,0.5);-webkit-backdrop-filter:blur(22px) saturate(1.1);backdrop-filter:blur(22px) saturate(1.1);opacity:0;visibility:hidden;transition:opacity .25s ease,visibility 0s linear .25s;}
.viewer.is-open{opacity:1;visibility:visible;transition:opacity .25s ease,visibility 0s;}
.viewer-stage{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;padding:3.5rem 1rem 1rem;}
.viewer-stage img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;display:block;box-shadow:0 20px 60px rgba(0,0,0,0.5);transform:scale(.96);transition:transform .35s cubic-bezier(.22,1,.36,1);}
.viewer.is-open .viewer-stage img{transform:none;}
.viewer-btn{position:absolute;z-index:2;width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.25);border:1px solid var(--hair);border-radius:4px;color:#f5f2ed;font-size:1.4rem;line-height:1;cursor:pointer;}
.viewer-btn:hover{background:rgba(0,0,0,0.5);}
.viewer-btn:focus-visible{outline:2px solid rgba(255,255,255,0.9);outline-offset:2px;}
.viewer-close{top:0.8rem;right:0.8rem;}
.viewer-prev{left:0.8rem;top:50%;transform:translateY(-50%);}
.viewer-next{right:0.8rem;top:50%;transform:translateY(-50%);}
@media (min-width:768px){
  .viewer-stage{padding:4.5rem 5.5rem 1.5rem;}
  .viewer-prev{left:1.4rem;}.viewer-next{right:1.4rem;}
}
@media (prefers-reduced-motion:reduce){
  .tt-photo img,.viewer,.viewer.is-open,.viewer-stage img{transition:none;}
}
</style>
</Fragment>
<main class="tattoo-page">
  <div class="tt-wrap">
    <header class="tt-head g-head">
      <div>
        <p class="g-kicker">Charles Days · +10 años · Diseños propios</p>
        <h1 class="g-title tt-title">Tatuador en Lima</h1>
        <p class="tt-intro">Tatúo en Surco y Miraflores, Lima, Perú. Trabajo realismo black and grey, ornamental black and red, lettering y fineline. Cuéntame tu idea y conversemos sobre tu próximo tattoo.</p>
        <div class="tt-styles">
          <a class="tt-style" href="#ornamental">Ornamental black <b>&amp; red</b></a>
          <a class="tt-style" href="#realismo">Realismo black &amp; grey</a>
          <a class="tt-style" href="#lettering">Lettering · Dark lettering</a>
          <a class="tt-style" href="#fineline">Fineline</a>
        </div>
      </div>
      <div class="tt-actions">
        <a class="tt-btn tt-btn-solid" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Escríbeme por WhatsApp</a>
        <a class="tt-btn tt-btn-ghost" href="https://www.instagram.com/charlesdays.art" target="_blank" rel="noopener noreferrer">Instagram<svg class="ext-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a>
      </div>
    </header>
  </div>

  <section class="tt-wrap tt-gallery-heading" aria-labelledby="galleryTitle">
    <p class="g-kicker">Portafolio · Charles Days</p>
    <h2 id="galleryTitle">Mis trabajos de tatuaje</h2>
    <p>Explora una selección de realismo, ornamental y lettering. Abre cada foto para ver el trabajo en detalle.</p>
  </section>
  <div class="tt-gallery" id="ttGallery" aria-label="Galería de tatuajes">
    {TILES.map((t, i) => (
      <figure class="tt-work">
        <button type="button" class="tt-photo" data-i={i} data-full={t.src} aria-label={`Ver: ${t.alt}`}>
          <img src={smSrc(t.src)} alt={t.alt} width={t.w} height={t.h} loading="lazy" decoding="async" />
        </button>
        <figcaption>{t.alt}</figcaption>
      </figure>
    ))}
  </div>

  <section class="tt-quote" id="cotizar" aria-labelledby="quoteTitle">
    <div class="tt-quote-bg" aria-hidden="true"><img src="/images/sm/manifiesto/canvas-wide.webp" alt="" loading="lazy" decoding="async"></div>
    <div class="tt-wrap tt-quote-inner">
      <div>
        <p class="g-kicker">Conversemos</p>
        <h2 class="tt-quote-h" id="quoteTitle">¿TIENES UNA IDEA?</h2>
        <p class="tt-quote-p">Cuéntame tu idea o mándame una referencia. Vemos los detalles por WhatsApp.</p>
      </div>
      <a class="tt-btn tt-btn-solid" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Escríbeme por WhatsApp <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="tt-wrap tt-info" aria-labelledby="stylesTitle">
    <h2 id="stylesTitle">Estilos de tatuaje que trabajo en Lima</h2>
    <div class="tt-info-grid">
      <div class="tt-style-info" id="realismo"><h3>Realismo black and grey</h3><p>Trabajo en negro y grises. En la galería puedes ver águilas, un camaleón, un mapache y otros proyectos de realismo.</p></div>
      <div class="tt-style-info" id="ornamental"><h3>Ornamental black and red</h3><p>Diseños ornamentales en negro y rojo, con trabajos de estilo neotribal en pecho, espalda, brazos y piernas.</p></div>
      <div class="tt-style-info" id="lettering"><h3>Lettering y dark lettering</h3><p>Letras y composiciones tipográficas para la piel. Explora los trabajos de dark lettering y lettering gótico de la galería.</p></div>
      <div class="tt-style-info" id="fineline"><h3>Fineline</h3><p>También trabajo tatuajes de línea fina. Envíame tu idea, la zona del cuerpo y el tamaño aproximado para conversar sobre el diseño.</p></div>
    </div>
  </section>

  <section class="tt-wrap tt-info" aria-labelledby="bookingTitle">
    <h2 id="bookingTitle">¿Cómo tatuarte conmigo en Lima?</h2>
    <details open><summary>¿Dónde atiendes?</summary><p>Tatúo en Lima, en Surco y Miraflores. Escríbeme por WhatsApp para coordinar el lugar y la fecha de tu cita.</p></details>
    <details><summary>¿Cómo puedo cotizar un tatuaje?</summary><p>Escríbeme directamente por WhatsApp. Puedes contarme tu idea o enviarme una referencia; conversamos por ahí sobre el diseño, el tamaño, la zona del cuerpo y la fecha.</p></details>
    <details><summary>¿Qué estilos de tatuaje trabajas?</summary><p>Realismo black and grey, ornamental black and red, lettering, dark lettering y fineline. Si todavía no sabes qué estilo elegir, escríbeme y lo conversamos.</p></details>
    <a class="tt-btn tt-btn-solid" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Hablemos de tu tatuaje</a>
  </section>


  <footer class="tt-wrap tt-foot">
    <span>Charles Days · Tattoo</span>
    <a class="g-link" href="/about/#contacto">Contacto</a>
  </footer>
</main>

<div id="viewer" class="viewer" role="dialog" aria-modal="true" aria-label="Visor de imagen">
  <button type="button" class="viewer-btn viewer-close" id="viewerClose" aria-label="Cerrar">&times;</button>
  <button type="button" class="viewer-btn viewer-prev" id="viewerPrev" aria-label="Anterior">&larr;</button>
  <button type="button" class="viewer-btn viewer-next" id="viewerNext" aria-label="Siguiente">&rarr;</button>
  <div class="viewer-stage" id="viewerStage"><img id="viewerImg" alt=""></div>
</div>

<script is:inline type="module">
/* Photos and descriptions are in the initial HTML. JavaScript only adds the image viewer. */
var TILES = Array.from(document.querySelectorAll('#ttGallery .tt-photo')).map(function (button) {
  return { src: button.getAttribute('data-full'), alt: button.querySelector('img').alt };
});
function smSrc(src) {
  return '/images/sm/' + src.slice('/images/'.length).replace(/\.[^./]+$/, '') + '.webp';
}

/* === Pop-out viewer ===================================================== */
(function () {
  var viewer = document.getElementById('viewer');
  var img = document.getElementById('viewerImg');
  var closeBtn = document.getElementById('viewerClose');
  var index = -1;
  var lastTrigger = null;

  function show(i) {
    index = (i + TILES.length) % TILES.length;
    var t = TILES[index];
    img.src = smSrc(t.src);
    img.alt = t.alt;
    var hd = new Image();
    var want = index;
    hd.onload = function () { if (index === want && viewer.classList.contains('is-open')) img.src = t.src; };
    hd.src = t.src;
  }

  function onKey(e) {
    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
    else if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
    else if (e.key === 'Tab') {
      var f = Array.prototype.slice.call(viewer.querySelectorAll('button'));
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  }

  function open(i, trigger) {
    lastTrigger = trigger;
    viewer.classList.add('is-open');
    show(i);
    document.documentElement.style.overflow = 'hidden';
    document.addEventListener('keydown', onKey, true);
    closeBtn.focus();
  }

  function close() {
    viewer.classList.remove('is-open');
    document.documentElement.style.overflow = '';
    document.removeEventListener('keydown', onKey, true);
    if (lastTrigger) lastTrigger.focus({ preventScroll: true });
  }

  document.getElementById('ttGallery').addEventListener('click', function (e) {
    var b = e.target.closest('.tt-photo');
    if (b) open(+b.getAttribute('data-i'), b);
  });
  closeBtn.addEventListener('click', close);
  document.getElementById('viewerPrev').addEventListener('click', function () { show(index - 1); });
  document.getElementById('viewerNext').addEventListener('click', function () { show(index + 1); });
  viewer.addEventListener('click', function (e) {
    if (e.target === viewer || e.target.id === 'viewerStage') close();
  });

  /* Swipe left/right on touch screens. */
  var sx = null, sy = 0;
  viewer.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
  viewer.addEventListener('touchend', function (e) {
    if (sx === null) return;
    var dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
    sx = null;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
  });
})();

</script>
