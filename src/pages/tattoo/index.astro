---
import Base from '../../layouts/Base.astro';
import { byId, smSrc } from '../../lib/media';

const whatsappUrl = 'https://wa.me/51923386692?text=' + encodeURIComponent('Hola Charles, vi tus tatuajes y me gustaría conversar sobre una idea.');

function fromStory(id: string, w: number, h: number, alt: string) {
  const s = byId[id];
  if (!s?.cover) throw new Error(`Missing tattoo cover: ${id}`);
  return { src: s.cover.src, alt: alt || s.cover.alt || '', w: w, h: h };
}

const abdomen = byId['tattoo-black-red'].supportingImages?.[0];
if (!abdomen) throw new Error('Missing tattoo supporting image: tattoo-black-red');

const TILES = [
  fromStory('tattoo-neck-sky', 900, 1600, 'Tatuaje ornamental negro estilo neotribal en cabeza, cuello y espalda, frente al mar'),
  { src: '/images/tattoo/tiki.jpg', alt: 'Tatuaje en línea negra de máscara tiki con hojas en antebrazo', w: 900, h: 1600 },
  fromStory('tattoo-eagle-profile', 332, 378, 'Tatuaje realista black and grey de águila de perfil en pierna'),
  { src: '/images/tattoo/wolf.jpg', alt: 'Tatuaje realista de lobo con detalles en rojo y ornamental negro en brazo', w: 1200, h: 1600 },
  { src: '/images/tattoo/chameleon.jpg', alt: 'Tatuaje realista black and grey de camaleón en pierna', w: 1279, h: 1600 },
  { src: '/images/tattoo/chest-ornamental-black.jpg', alt: 'Tatuaje ornamental negro estilo neotribal en pecho y abdomen', w: 1200, h: 1600 },
  fromStory('tattoo-black-red', 900, 1600, 'Tatuaje ornamental black and red estilo neotribal en pecho y hombro'),
  { src: '/images/tattoo/head-lettering.jpg', alt: 'Dark lettering en la cabeza y detrás de la oreja', w: 900, h: 1600 },
  { src: '/images/tattoo/raccoon.jpg', alt: 'Tatuaje realista black and grey de mapache en antebrazo', w: 1279, h: 1600 },
  { src: '/images/tattoo/lettering-arm.jpg', alt: 'Dark lettering gótico en pierna', w: 1201, h: 1600 },
  fromStory('tattoo-leg-red-black', 900, 1600, 'Tatuaje ornamental black and red estilo neotribal en pantorrilla'),
  { src: '/images/tattoo/freddy.jpg', alt: 'Tatuaje realista black and grey de Freddy Krueger con detalles en rojo en muslo', w: 1200, h: 1600 },
  fromStory('tattoo-ornamental-face', 1200, 1600, 'Tatuaje ornamental negro estilo neotribal en rostro y cabeza, de la oreja a la mandíbula'),
  { src: abdomen.src, alt: 'Tatuaje ornamental black and red estilo neotribal en pecho y abdomen', w: 1200, h: 1600 },
  { src: '/images/wall/tattoo-eagle.png', alt: 'Tatuaje realista black and grey de águila en brazo completo', w: 731, h: 1397 },
  { src: '/images/tattoo/lettering-floral.jpg', alt: 'Dark lettering con detalle floral en brazo completo', w: 900, h: 1600 }
];


