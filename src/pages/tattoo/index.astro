---
import Base from '../../layouts/Base.astro';
---
<Base>
<Fragment slot="head">
<title>Tatuador en Lima — Realismo black and grey y ornamental black and red | Charles Days</title>
<meta name="description" content="Tatuajes de realismo black and grey, ornamental black and red, lettering y fineline en Lima (Surco y Miraflores). Diseños propios, +10 años. Mira el trabajo y cotiza por WhatsApp.">
<link rel="canonical" href="https://charlesdays.art/tattoo/">
<meta property="og:type" content="website">
<meta property="og:title" content="Tatuador en Lima — Realismo black and grey y ornamental black and red | Charles Days">
<meta property="og:description" content="Tatuajes de realismo black and grey, ornamental black and red, lettering y fineline en Lima (Surco y Miraflores). Diseños propios, +10 años. Mira el trabajo y cotiza por WhatsApp.">
<meta property="og:url" content="https://charlesdays.art/tattoo/">
<meta property="og:image" content="https://charlesdays.art/images/wall/tattoo-neck-sky.jpg">
<meta property="og:image:alt" content="Tatuaje ornamental negro estilo neotribal en cabeza, cuello y espalda, frente al mar">
