<style is:inline>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&family=Space+Grotesk:wght@500;700&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#000;--text:#f5f2ed;--text-muted:#9aa4c2;--hair:rgba(245,242,237,0.12);--hair-strong:rgba(245,242,237,0.28);
  --font-display:'Space Grotesk', sans-serif;
}
html{background:var(--bg);overflow-x:clip;}
html,body{color:var(--text);font-family:'DM Sans',sans-serif;}
/* overflow-x:clip, not hidden, and only on html — any non-visible
   *overflow* value (on either html or body) forces the other axis to
   compute to "auto", turning that element into its own scroll
   container, which silently breaks position:sticky on this page's side
   columns further down. `clip` blocks horizontal overflow the same way
   without that side effect. */

.tattoo-page{padding-top:var(--nav-h);}

/* ===== Tattoo page — dark, image-first. A short header (title, styles,
   two actions), a full-width masonry gallery that shows every photo
   uncropped, then a visual quote builder that hands off to WhatsApp.
   Photos open in the same blurred pop-out as the Wall (HD original
   swapped in once loaded). ===== */
.tt-wrap{width:min(100% - 2 * var(--gutter),var(--container));margin:0 auto;}

/* Corners: photos are square; tags, buttons, the form and the viewer
   controls share one small 4–6px radius — no pills, no hard boxes. */

/* --- header: same kicker + big title as every section (/assets/nav.css),
   then the styles as square tags and two square actions --- */
.tt-head{display:grid;gap:1.6rem;padding-bottom:1.8rem;}
.tt-styles{display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:1.4rem;}
.tt-style{font-size:0.68rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--text);border:1px solid var(--hair-strong);border-radius:4px;padding:0.55rem 0.85rem;}
.tt-style b{font-weight:500;color:#e2312d;}
.tt-actions{display:flex;flex-wrap:wrap;gap:0.6rem;align-items:stretch;}
.tt-btn{display:inline-flex;align-items:center;gap:0.6em;font-size:0.7rem;font-weight:500;letter-spacing:0.16em;text-transform:uppercase;text-decoration:none;padding:1rem 1.4rem;border:1px solid var(--text);border-radius:4px;transition:background .2s ease,color .2s ease;}
.tt-btn-solid{background:var(--text);color:#0b0b0b;}
.tt-btn-solid:hover{background:transparent;color:var(--text);}
.tt-btn-ghost{color:var(--text);border-color:var(--hair-strong);}
.tt-btn-ghost:hover{background:var(--text);color:#0b0b0b;}
.tt-btn:focus-visible{outline:2px solid rgba(255,255,255,0.9);outline-offset:3px;}
.ext-icon{width:13px;height:13px;flex-shrink:0;}
@media (min-width:900px){
  .tt-head{grid-template-columns:1fr auto;align-items:end;}
}

/* --- gallery: CSS columns masonry, every photo at its own aspect ratio
   (width/height attributes reserve the space, so nothing jumps while the
   lazy images arrive). Square corners. No zoom and no caption on hover —
   the photo just brightens.
   Pinterest-style: the column count follows the viewport (2 on phones,
   then as many ~210px columns as fit the content width). --- */
.tt-gallery{columns:2;column-gap:6px;padding:0 6px;}
@media (min-width:600px){.tt-gallery{columns:210px;width:min(100% - 2 * var(--gutter),var(--container));margin:0 auto;padding:0;}}
.tt-photo{position:relative;display:block;width:100%;margin:0 0 6px;break-inside:avoid;overflow:hidden;background:#111;cursor:zoom-in;border:0;padding:0;}
.tt-photo img{display:block;width:100%;height:auto;filter:brightness(.88);transition:filter .45s ease;}
@media (hover:hover){.tt-photo:hover img{filter:brightness(1);}}
.tt-photo:focus-visible{outline:2px solid rgba(255,255,255,0.9);outline-offset:-2px;}

/* --- quote: a compact band between the header and the gallery, over the
   wide black-and-gold calligraphy canvas from Manifiesto. Kept short so
   the first photos still show below it on a laptop screen. --- */
.tt-quote{position:relative;margin-bottom:1.2rem;overflow:hidden;isolation:isolate;border-top:1px solid var(--hair);border-bottom:1px solid var(--hair);}
.tt-quote-bg{position:absolute;inset:0;z-index:-1;}
.tt-quote-bg img{width:100%;height:100%;object-fit:cover;object-position:75% 50%;filter:brightness(.55) contrast(1.05);}
.tt-quote-bg::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,0.25) 0%,rgba(0,0,0,0.15) 40%,rgba(0,0,0,0.7) 70%,rgba(0,0,0,0.85) 100%),linear-gradient(to bottom,#000 0%,rgba(0,0,0,0) 18%,rgba(0,0,0,0) 82%,#000 100%);}
.tt-quote-inner{display:grid;gap:1.4rem;padding:1.8rem 0;}
.tt-quote-h{font-family:var(--font-display);font-weight:700;font-size:clamp(1.8rem,4vw,3rem);letter-spacing:-0.03em;line-height:0.92;color:var(--text);text-shadow:0 4px 30px rgba(0,0,0,0.5);}
.tt-quote-p{margin-top:0.9rem;max-width:22rem;font-size:0.86rem;line-height:1.55;color:#d6d3cd;}
.tt-quote-inner .g-kicker{margin-bottom:0.8rem;}
/* Frosted glass over the calligraphy. The blur is limited to this one
   card (the page-wide blur layer was what made scrolling heavy before). */
.tt-card{background:rgba(14,14,14,0.42);-webkit-backdrop-filter:blur(20px) saturate(1.15);backdrop-filter:blur(20px) saturate(1.15);border:1px solid rgba(245,242,237,0.16);border-radius:6px;padding:1.2rem 1.1rem 1rem;}
@media (min-width:900px){
  .tt-quote-inner{grid-template-columns:1fr minmax(0,680px);align-items:center;gap:4vw;padding:1.6rem 0;}
  .tt-card{padding:1.1rem 1.4rem 1rem;}
  .q-group{margin-bottom:0.45rem;}
  .q-fields{margin-top:0.5rem;}
  /* each choice row: legend on the left, options beside it */
  .q-group-row{display:grid;grid-template-columns:4.6rem 1fr;align-items:baseline;}
  .q-group-row .q-legend{float:left;margin:0;}
  .q-fields{display:grid;grid-template-columns:1fr 2fr;gap:0 1.4rem;}
}

/* Choices are real radio inputs; each shows as plain text that gets a soft
   fill when picked — no boxes, no pills, no step numbers. */
.q-group{border:0;margin:0 0 0.9rem;padding:0;min-width:0;}
.q-legend{font-size:0.62rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--text-muted);margin-bottom:0.6rem;padding:0;}
.q-pills{display:flex;flex-wrap:wrap;gap:0.15rem 0.3rem;margin-left:-0.6rem;}
.q-pill{position:relative;}
.q-pill input{position:absolute;opacity:0;width:1px;height:1px;}
.q-pill span{display:inline-flex;align-items:baseline;gap:0.45em;font-size:0.84rem;color:rgba(245,242,237,0.78);padding:0.35rem 0.55rem;border-radius:4px;cursor:pointer;user-select:none;transition:background .15s ease,color .15s ease;}
.q-pill span small{font-size:0.66rem;color:inherit;opacity:0.6;}
.q-pill span:hover{color:var(--text);background:rgba(245,242,237,0.08);}
.q-pill input:checked + span{background:var(--text);color:#0b0b0b;}
.q-pill input:focus-visible + span{outline:2px solid rgba(255,255,255,0.9);outline-offset:1px;}

.q-field{display:block;margin-bottom:0.9rem;}
.q-label{display:block;font-size:0.62rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--text-muted);margin-bottom:0.2rem;}
.q-input,.q-textarea{width:100%;background:transparent;border:0;border-bottom:1px solid rgba(245,242,237,0.28);border-radius:0;color:var(--text);font-family:'DM Sans',sans-serif;font-size:1rem;font-weight:400;padding:0.6rem 0;transition:border-color .15s ease;}
.q-textarea{min-height:2.6rem;line-height:1.5;resize:vertical;}
.q-input::placeholder,.q-textarea::placeholder{color:rgba(245,242,237,0.35);}
.q-input:focus,.q-textarea:focus{outline:none;border-bottom-color:var(--text);}
.q-submit{margin-top:0.4rem;width:100%;display:flex;align-items:center;justify-content:space-between;gap:0.6em;background:var(--text);color:#0b0b0b;border:0;border-radius:4px;font-family:'DM Sans',sans-serif;font-weight:500;font-size:0.74rem;letter-spacing:0.18em;text-transform:uppercase;padding:0.95rem 1.3rem;cursor:pointer;transition:background .2s ease,color .2s ease;}
.q-submit:hover{background:#e2312d;color:#fff;}
.q-submit:focus-visible{outline:2px solid #fff;outline-offset:3px;}
.q-submit svg{width:18px;height:18px;}
.q-open{display:none;}
/* Phones: the form starts folded behind one button so the photos stay close. */
@media (max-width:899px){
  .tt-quote.is-folded .tt-card{display:none;}
  .tt-quote.is-folded .q-open{display:flex;margin-top:1.2rem;}
}
.q-note{margin-top:0.7rem;font-size:0.66rem;letter-spacing:0.03em;color:var(--text-muted);}

.tt-foot{padding:4rem 0 3rem;display:flex;justify-content:space-between;gap:1rem;font-size:0.62rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--text-muted);}

/* --- pop-out viewer (same treatment as the Wall's) --- */
.viewer{position:fixed;inset:0;z-index:200;display:flex;flex-direction:column;background:rgba(0,0,0,0.5);-webkit-backdrop-filter:blur(22px) saturate(1.1);backdrop-filter:blur(22px) saturate(1.1);opacity:0;visibility:hidden;transition:opacity .25s ease,visibility 0s linear .25s;}
.viewer.is-open{opacity:1;visibility:visible;transition:opacity .25s ease,visibility 0s;}
.viewer-stage{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;padding:3.5rem 1rem 1rem;}
.viewer-stage img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;display:block;box-shadow:0 20px 60px rgba(0,0,0,0.5);transform:scale(.96);transition:transform .35s cubic-bezier(.22,1,.36,1);}
.viewer.is-open .viewer-stage img{transform:none;}
.viewer-btn{position:absolute;z-index:2;width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.25);border:1px solid var(--hair);border-radius:4px;color:#f5f2ed;font-size:1.4rem;line-height:1;cursor:pointer;}
.viewer-btn:hover{background:rgba(0,0,0,0.5);}
.viewer-btn:focus-visible{outline:2px solid rgba(255,255,255,0.9);outline-offset:2px;}
.viewer-close{top:0.8rem;right:0.8rem;}
.viewer-prev{left:0.8rem;top:50%;transform:translateY(-50%);}
.viewer-next{right:0.8rem;top:50%;transform:translateY(-50%);}
@media (min-width:768px){
  .viewer-stage{padding:4.5rem 5.5rem 1.5rem;}
  .viewer-prev{left:1.4rem;}.viewer-next{right:1.4rem;}
}
@media (prefers-reduced-motion:reduce){
  .tt-photo img,.viewer,.viewer.is-open,.viewer-stage img{transition:none;}
}
</style>
</Fragment>
<main class="tattoo-page">
  <div class="tt-wrap">
    <header class="tt-head g-head">
      <div>
        <p class="g-kicker">Lima, Perú · +10 años · Diseños propios</p>
        <h1 class="g-title">TATTOO</h1>
        <div class="tt-styles">
          <span class="tt-style">Ornamental black <b>&amp; red</b></span>
          <span class="tt-style">Realism black &amp; grey</span>
          <span class="tt-style">Lettering · Dark lettering</span>
          <span class="tt-style">Fineline</span>
        </div>
      </div>
      <div class="tt-actions">
        <a class="tt-btn tt-btn-ghost" href="https://www.instagram.com/charlesdays.art" target="_blank" rel="noopener noreferrer">Instagram<svg class="ext-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a>
      </div>
    </header>
  </div>

  <section class="tt-quote is-folded" id="cotizar" aria-labelledby="quoteTitle">
    <div class="tt-quote-bg" aria-hidden="true"><img src="/images/sm/manifiesto/canvas-wide.webp" alt="" decoding="async"></div>
    <div class="tt-wrap tt-quote-inner">
      <div>
        <p class="g-kicker">Cotización</p>
        <h2 class="tt-quote-h" id="quoteTitle">¿TIENES<br>UNA IDEA?</h2>
        <p class="tt-quote-p">Cuéntame qué tienes en mente y te llega directo a WhatsApp. Referencias, tamaño exacto y fecha los vemos ahí.</p>
        <p class="q-note">Se abre WhatsApp con tu mensaje listo. No se guarda nada aquí.</p>
        <button type="button" class="q-submit q-open" id="quoteOpen" aria-controls="inquiryForm" aria-expanded="false"><span>Cotiza tu tattoo</span><span aria-hidden="true">&darr;</span></button>
      </div>

      <form class="tt-card" id="inquiryForm">
        <fieldset class="q-group q-group-row">
          <legend class="q-legend">Estilo</legend>
          <div class="q-pills">
            <label class="q-pill"><input type="radio" name="style" value="Ornamental black & red"><span>Ornamental black &amp; red</span></label>
            <label class="q-pill"><input type="radio" name="style" value="Realismo black & grey"><span>Realismo black &amp; grey</span></label>
            <label class="q-pill"><input type="radio" name="style" value="Lettering"><span>Lettering</span></label>
            <label class="q-pill"><input type="radio" name="style" value="Fineline"><span>Fineline</span></label>
            <label class="q-pill"><input type="radio" name="style" value="Aún no sé"><span>Aún no sé</span></label>
          </div>
        </fieldset>

        <fieldset class="q-group q-group-row">
          <legend class="q-legend">Zona</legend>
          <div class="q-pills">
            <label class="q-pill"><input type="radio" name="zone" value="Brazo"><span>Brazo</span></label>
            <label class="q-pill"><input type="radio" name="zone" value="Antebrazo"><span>Antebrazo</span></label>
            <label class="q-pill"><input type="radio" name="zone" value="Pierna"><span>Pierna</span></label>
            <label class="q-pill"><input type="radio" name="zone" value="Espalda"><span>Espalda</span></label>
            <label class="q-pill"><input type="radio" name="zone" value="Pecho"><span>Pecho</span></label>
            <label class="q-pill"><input type="radio" name="zone" value="Cuello / cabeza"><span>Cuello / cabeza</span></label>
            <label class="q-pill"><input type="radio" name="zone" value="Otra"><span>Otra</span></label>
          </div>
        </fieldset>

        <fieldset class="q-group q-group-row">
          <legend class="q-legend">Tamaño</legend>
          <div class="q-pills">
            <label class="q-pill"><input type="radio" name="size" value="Pequeño (menos de 10 cm)"><span>Pequeño <small>&lt; 10 cm</small></span></label>
            <label class="q-pill"><input type="radio" name="size" value="Mediano (10–20 cm)"><span>Mediano <small>10–20 cm</small></span></label>
            <label class="q-pill"><input type="radio" name="size" value="Grande (más de 20 cm)"><span>Grande <small>&gt; 20 cm</small></span></label>
            <label class="q-pill"><input type="radio" name="size" value="Proyecto grande / varias sesiones"><span>Varias sesiones</span></label>
          </div>
        </fieldset>

        <fieldset class="q-group q-fields">
          <label class="q-field"><span class="q-label">Nombre</span>
            <input class="q-input" type="text" id="inquiryName" name="name" autocomplete="given-name" required>
          </label>
          <label class="q-field"><span class="q-label">Cuéntame la idea</span>
            <textarea class="q-textarea" id="inquiryIdea" name="idea" rows="2" placeholder="Qué te quieres hacer, referencias, algo que signifique para ti…" required></textarea>
          </label>
        </fieldset>

        <button class="q-submit" type="submit"><span>Enviar por WhatsApp</span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2a10 10 0 0 0-8.66 15l-1.3 4.76 4.88-1.28A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-2.9.76.78-2.83-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.55.12-.16.25-.63.8-.78.97-.14.16-.29.18-.53.06a6.7 6.7 0 0 1-3.34-2.92c-.25-.43.25-.4.72-1.34.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47a.9.9 0 0 0-.65.3 2.74 2.74 0 0 0-.86 2.04 4.76 4.76 0 0 0 1 2.53 10.9 10.9 0 0 0 4.18 3.7c1.56.67 2.17.73 2.95.61.48-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></svg></button>
      </form>
    </div>
  </section>

  <div class="tt-gallery" id="ttGallery" aria-label="Galería de tatuajes"></div>


  <footer class="tt-wrap tt-foot">
    <span>Charles Days · Tattoo</span>
    <a class="g-link" href="/about/#contacto">Contacto</a>
  </footer>
</main>

<div id="viewer" class="viewer" role="dialog" aria-modal="true" aria-label="Visor de imagen">
  <button type="button" class="viewer-btn viewer-close" id="viewerClose" aria-label="Cerrar">&times;</button>
  <button type="button" class="viewer-btn viewer-prev" id="viewerPrev" aria-label="Anterior">&larr;</button>
  <button type="button" class="viewer-btn viewer-next" id="viewerNext" aria-label="Siguiente">&rarr;</button>
  <div class="viewer-stage" id="viewerStage"><img id="viewerImg" alt=""></div>
</div>

<script is:inline type="module">
/* Tattoo page — dark, image-first rebuild. Replaces the bone "paper"
   column (cropped photos in two balanced strips, a light inline form)
   with: a masonry gallery showing every photo uncropped at its own
   aspect ratio, a blurred pop-out viewer with prev/next (HD original
   swapped in once loaded), and a visual quote builder that hands the
   whole brief to WhatsApp.

   Content is unchanged: same curated set and order as before, read from
   stories.js (discipline: ["tattoo"]) plus confirmed local tattoo photos.
   head-neck-night.jpg stays out (duplicate angle of tattoo-neck-sky) and
   sloth-hand stays out (only source is visibly degraded) — see the
   provenance notes in stories.js. Grid images are the standard-quality
   WebPs from scripts/make-sm-images.sh; w/h are those files' real
   (EXIF-rotated) pixel sizes, used to reserve each tile's space. */
import { stories } from '/stories.js';

var byId = {};
stories.forEach(function (s) { byId[s.id] = s; });

function fromStory(id, w, h, alt) {
  var s = byId[id];
  return { src: s.cover.src, alt: alt || s.cover.alt || '', w: w, h: h };
}

var abdomen = byId['tattoo-black-red'].supportingImages[0];

var TILES = [
  fromStory('tattoo-neck-sky', 900, 1600, 'Tatuaje ornamental negro estilo neotribal en cabeza, cuello y espalda, frente al mar'),
  { src: '/images/tattoo/tiki.jpg', alt: 'Tatuaje en línea negra de máscara tiki con hojas en antebrazo', w: 900, h: 1600 },
  fromStory('tattoo-eagle-profile', 332, 378, 'Tatuaje realista black and grey de águila de perfil en pierna'),
  { src: '/images/tattoo/wolf.jpg', alt: 'Tatuaje realista de lobo con detalles en rojo y ornamental negro en brazo', w: 1200, h: 1600 },
  { src: '/images/tattoo/chameleon.jpg', alt: 'Tatuaje realista black and grey de camaleón en pierna', w: 1279, h: 1600 },
  { src: '/images/tattoo/chest-ornamental-black.jpg', alt: 'Tatuaje ornamental negro estilo neotribal en pecho y abdomen', w: 1200, h: 1600 },
  fromStory('tattoo-black-red', 900, 1600, 'Tatuaje ornamental black and red estilo neotribal en pecho y hombro'),
  { src: '/images/tattoo/head-lettering.jpg', alt: 'Dark lettering en la cabeza y detrás de la oreja', w: 900, h: 1600 },
  { src: '/images/tattoo/raccoon.jpg', alt: 'Tatuaje realista black and grey de mapache en antebrazo', w: 1279, h: 1600 },
  { src: '/images/tattoo/lettering-arm.jpg', alt: 'Dark lettering gótico en pierna', w: 1201, h: 1600 },
  fromStory('tattoo-leg-red-black', 900, 1600, 'Tatuaje ornamental black and red estilo neotribal en pantorrilla'),
  { src: '/images/tattoo/freddy.jpg', alt: 'Tatuaje realista black and grey de Freddy Krueger con detalles en rojo en muslo', w: 1200, h: 1600 },
  fromStory('tattoo-ornamental-face', 1200, 1600, 'Tatuaje ornamental negro estilo neotribal en rostro y cabeza, de la oreja a la mandíbula'),
  { src: abdomen.src, alt: 'Tatuaje ornamental black and red estilo neotribal en pecho y abdomen', w: 1200, h: 1600 },
  { src: '/images/wall/tattoo-eagle.png', alt: 'Tatuaje realista black and grey de águila en brazo completo', w: 731, h: 1397 },
  { src: '/images/tattoo/lettering-floral.jpg', alt: 'Dark lettering con detalle floral en brazo completo', w: 900, h: 1600 }
];

/* /images/x/y.jpg -> /images/sm/x/y.webp (same mapping as the Wall). */
function smSrc(src) {
  return '/images/sm/' + src.slice('/images/'.length).replace(/\.[^./]+$/, '') + '.webp';
}

function esc(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

document.getElementById('ttGallery').innerHTML = TILES.map(function (t, i) {
  return '<button type="button" class="tt-photo" data-i="' + i + '" aria-label="Ver: ' + esc(t.alt) + '">' +
    '<img src="' + smSrc(t.src) + '" alt="' + esc(t.alt) + '" width="' + t.w + '" height="' + t.h + '"' +
    ' loading="' + (i < 4 ? 'eager' : 'lazy') + '" decoding="async">' +
  '</button>';
}).join('');

/* === Pop-out viewer ===================================================== */
(function () {
  var viewer = document.getElementById('viewer');
  var img = document.getElementById('viewerImg');
  var closeBtn = document.getElementById('viewerClose');
  var index = -1;
  var lastTrigger = null;

  function show(i) {
    index = (i + TILES.length) % TILES.length;
    var t = TILES[index];
    img.src = smSrc(t.src);
    img.alt = t.alt;
    var hd = new Image();
    var want = index;
    hd.onload = function () { if (index === want && viewer.classList.contains('is-open')) img.src = t.src; };
    hd.src = t.src;
  }

  function onKey(e) {
    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
    else if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
    else if (e.key === 'Tab') {
      var f = Array.prototype.slice.call(viewer.querySelectorAll('button'));
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  }

  function open(i, trigger) {
    lastTrigger = trigger;
    viewer.classList.add('is-open');
    show(i);
    document.documentElement.style.overflow = 'hidden';
    document.addEventListener('keydown', onKey, true);
    closeBtn.focus();
  }

  function close() {
    viewer.classList.remove('is-open');
    document.documentElement.style.overflow = '';
    document.removeEventListener('keydown', onKey, true);
    if (lastTrigger) lastTrigger.focus({ preventScroll: true });
  }

  document.getElementById('ttGallery').addEventListener('click', function (e) {
    var b = e.target.closest('.tt-photo');
    if (b) open(+b.getAttribute('data-i'), b);
  });
  closeBtn.addEventListener('click', close);
  document.getElementById('viewerPrev').addEventListener('click', function () { show(index - 1); });
  document.getElementById('viewerNext').addEventListener('click', function () { show(index + 1); });
  viewer.addEventListener('click', function (e) {
    if (e.target === viewer || e.target.id === 'viewerStage') close();
  });

  /* Swipe left/right on touch screens. */
  var sx = null, sy = 0;
  viewer.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
  viewer.addEventListener('touchend', function (e) {
    if (sx === null) return;
    var dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
    sx = null;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
  });
})();

/* === WhatsApp quote ======================================================
   No backend. The chosen pills (all optional) plus name and idea become a
   prefilled wa.me message; references, exact size and dates are handled
   with Charles directly on WhatsApp afterwards. */
var WHATSAPP_NUMBER = '51923386692'; // Charles' WhatsApp number

document.getElementById('quoteOpen').addEventListener('click', function () {
  document.getElementById('cotizar').classList.remove('is-folded');
  this.setAttribute('aria-expanded', 'true');
  document.getElementById('inquiryName').focus();
});

document.getElementById('inquiryForm').addEventListener('submit', function (e) {
  e.preventDefault();
  var form = e.target;
  function picked(name) { var el = form.querySelector('input[name="' + name + '"]:checked'); return el ? el.value : ''; }
  var lines = ['Hola Charles, quiero cotizar un tattoo.', '', 'Mi nombre es: ' + document.getElementById('inquiryName').value.trim()];
  if (picked('style')) lines.push('Estilo: ' + picked('style'));
  if (picked('zone')) lines.push('Zona: ' + picked('zone'));
  if (picked('size')) lines.push('Tamaño: ' + picked('size'));
  lines.push('', 'Mi idea:', document.getElementById('inquiryIdea').value.trim());
  window.open('https://wa.me/' + WHATSAPP_NUMBER + '?text=' + encodeURIComponent(lines.join('\n')), '_blank', 'noopener');
});

