---
import Base from '../../layouts/Base.astro';
---
<Base>
<Fragment slot="head">
<title>Art Direction — Charles Days</title>
<meta name="description" content="Art direction and visual intervention work by Charles Days — murals, album art, vehicle and object interventions, and brand identity.">
<link rel="canonical" href="https://charlesdays.art/art-direction/">
<meta property="og:type" content="website">
<meta property="og:title" content="Art Direction — Charles Days">
<meta property="og:description" content="Art direction and visual intervention work by Charles Days — murals, album art, vehicle and object interventions, and brand identity.">
<meta property="og:url" content="https://charlesdays.art/art-direction/">
<meta property="og:image" content="https://charlesdays.art/images/stories/interlock/cover.jpg">
<meta property="og:image:alt" content="Mural terminado — grandes formas geométricas azules entrelazadas con elementos caligráficos blancos/plateados sobre fondo oscuro">
<style is:inline>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&family=Space+Grotesk:wght@500;700&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#000;--text:#f5f2ed;--text-muted:#c7cbd6;--font-display:'Space Grotesk', sans-serif;}
html{background:var(--bg);}
html,body{color:var(--text);font-family:'DM Sans',sans-serif;overflow-x:hidden;}

/* Header layout (sizes, centering, gradient) lives in /assets/nav.css. */

/* ===== opening — extremely compact, clears the nav and stops ===== */
.intro{padding:calc(var(--nav-h) + 1rem) 1.2rem 0.5rem;}
.intro h1{font-family:var(--font-display);font-weight:700;font-size:clamp(1.4rem,3.4vw,2.1rem);letter-spacing:-0.01em;line-height:1;color:var(--text);}

/* ===== strips — edge to edge, near-continuous vertical stack ===== */
.strips{display:flex;flex-direction:column;}

.strip{
  position:relative;display:block;overflow:hidden;isolation:isolate;
  height:35vh;margin-bottom:2px;background:#050505;
  text-decoration:none;color:inherit;cursor:pointer;
}
.strip:last-child{margin-bottom:0;}
.strip:focus-visible{outline:2px solid rgba(255,255,255,0.9);outline-offset:-3px;}

/* Explicit z-index (not just DOM order) — .strip-img and .strip::before
   both use transitions on transform/opacity, which can promote either
   to its own compositing layer. With z-index:auto on both, the browser
   is free to composite them in whichever order it likes, which produced
   real, per-strip-inconsistent stacking in Safari (image over gradient
   on some strips, gradient over image on others). `isolation:isolate`
   on .strip plus explicit z-index below removes that ambiguity. */
/* Hover: the photo slowly pans upward inside the strip (no zoom, no height
   change, nothing else on the page moves). The image is 30% taller than
   the strip and starts centered (top:-15%), so it can travel exactly
   15% of the strip (= 11.5% of its own height) before its bottom edge
   would show. Leaving glides back at the same slow pace. Only on devices
   that really hover, so a tap on mobile never triggers it. */
.strip-img{position:absolute;left:0;top:-15%;z-index:0;width:100%;height:130%;object-fit:cover;transition:transform 1.6s cubic-bezier(.25,.1,.25,1);will-change:transform;-webkit-user-drag:none;}
@media (hover:hover){
  .strip:hover .strip-img{transform:translateY(-11.5%);}
}
.strip:focus-visible .strip-img{transform:translateY(-11.5%);}

/* Single horizontal vignette from the left edge, protecting the title/
   metadata block. Same values on every strip — no per-project darkness
   values. */
.strip::before{
  content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
  background: linear-gradient(
    90deg,
    rgba(0,0,0,0.78) 0%,
    rgba(0,0,0,0.58) 18%,
    rgba(0,0,0,0.30) 36%,
    rgba(0,0,0,0.10) 52%,
    rgba(0,0,0,0) 66%
  );
  transition:opacity .4s ease;
}
.strip:hover::before,.strip:focus-visible::before{opacity:0.82;}

.strip-meta{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:1.4rem 1.6rem;max-width:min(92%,980px);}
.strip-title{font-family:var(--font-display);font-weight:700;text-transform:uppercase;font-size:clamp(1.6rem,2.8vw,3rem);letter-spacing:-0.01em;line-height:0.98;color:var(--text);}
.strip-sub{margin-top:0.3rem;font-size:0.7rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);}

.strip-hint{position:absolute;right:1.3rem;bottom:1.5rem;z-index:2;font-size:0.58rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--text);text-shadow:0 1px 4px rgba(0,0,0,0.7),0 2px 12px rgba(0,0,0,0.55);opacity:0;transition:opacity .3s ease;pointer-events:none;}
.strip:hover .strip-hint,.strip:focus-visible .strip-hint{opacity:1;}

@media (min-width:768px){
  .strip-meta{padding:1.8rem 2.4rem;}
  .strip-hint{right:2rem;bottom:1.9rem;}
}

@media (prefers-reduced-motion:reduce){
  .strip-img{transition:none;}
  .strip:hover .strip-img,.strip:focus-visible .strip-img{transform:none;}
  .strip::before{transition:none;}
}

/* ===== mobile — taller strips, still near-continuous, no hover dependency ===== */
@media (max-width:767px){
  .intro{padding:calc(var(--nav-h) + 0.5rem) 1rem 0.5rem;}
  .strip{height:34vh;}
  /* Was `height:inherit` — that doesn't mean "keep 34vh", it resolves
     against the parent's (auto) height, which collapsed the tapped strip
     since its only in-flow content is the meta text. On touch devices the
     tap-triggered :hover/:focus-visible match fired that collapse mid-tap,
     shifting every strip below it before the click coordinates resolved —
     root cause of a tap opening the wrong project. Hover no longer
     changes height at all, so nothing here needs overriding. */
  .strip-meta{padding:1.2rem 1.1rem;max-width:100%;}
  .strip-title{font-size:clamp(1.5rem,6vw,2.2rem);}
}
</style>
</Fragment>
<main>
  <header class="intro">
    <h1>ART DIRECTION</h1>
  </header>

  <div id="strips" class="strips"></div>
</main>

<script is:inline type="module">
/* Standalone visual prototype (Prototype C) for /art-direction. Reads
   real entries directly from stories.js (discipline: ["art-direction"])
   — no parallel content database, and only each story's own `cover` is
   used by default; supportingImages are never read except for the one
   explicit, documented strip-image override below. Sequence and
   per-project object-position are prototype-only curation, kept out of
   stories.js — not wired into production nav. index.html/film.html/
   stories.js and the two earlier prototypes are untouched.

   Strip height is intentionally uniform now (see .strip in the CSS) —
   an earlier regular/feature two-height system added geometry variety
   that didn't read as meaningfully different in real-browser review, so
   it was normalized. Visual variety comes from imagery/crop/color only. */
import { stories } from '/stories.js';

var byId = {};
stories.forEach(function (s) { byId[s.id] = s; });

/* Deliberately cropped teasers, not full-photograph documentation —
   object-position chosen per cover so the strongest recognizable
   visual information survives a short, wide strip.

   3rd Gen Building Systems is the one entry with an `image` override:
   its canonical cover already carries the full "3RDGEN BUILDING
   SYSTEMS" wordmark, which fought the strip's own title overlay
   (redundant typography). This prototype strip uses the existing
   supportingImages[1] (the crane/HVAC installation photo — no logo)
   instead. The canonical cover in stories.js is untouched; this is a
   prototype-local presentation choice only. */
var SEQUENCE = [
  { id: 'art', pos: '50% 41%' },
  { id: 'vida-bandida-tracks', pos: '50% 34%' },
  { id: 'highend-night-car-meet', pos: '32% 42%' },
  {
    id: 'new-yorker-85',
    pos: '50% 40%',
    posMobile: '50% 40%',
    image: { src: '/images/stories/new-yorker-85/detail-01.png', alt: 'Persona sentada frente al costado del auto amarillo' }
  },
  { id: 'internazionale', pos: '50% 66%' },
  {
    id: '3rd-gen-building-systems',
    pos: '50% 33%',
    image: { src: '/images/stories/3rd-gen-building-systems/detail-02.png', alt: 'Instalación de equipo HVAC en azotea, grúa levantando equipo, dos trabajadores' }
  },
  { id: 'vidabandida-buenas-malas-decisiones', pos: '50% 8%' },
  {
    id: 'vidabandida-chlorotype-series',
    pos: '50% 20%',
    image: { src: '/images/stories/vidabandida-chlorotype-series/detail-06.jpeg', alt: 'Los tres integrantes de Vidabandida — Chlorotype caminando por la calle: gorro bucket a la izquierda, trenzas al centro, gorra rosa a la derecha' }
  },
  { id: 'ufology', pos: '50% 50%' },
  { id: 'mr-enz-x-charles-days', pos: '50% 30%' },
  { id: 'reflections', pos: '45% 42%' },
  { id: 'interlock', pos: '50% 42%' }
];

function esc(s) { return String(s == null ? '' : s).replace(/"/g, '&quot;'); }

function metaLine(story) {
  var role = Array.isArray(story.role) && story.role.length ? story.role.join(', ') : '';
  var year = story.year ? String(story.year) : '';
  if (role && year) return role + ' · ' + year;
  return role || year || '';
}

function stripHTML(entry, index) {
  var s = byId[entry.id];
  if (!s) return '';
  var sub = metaLine(s);
  var loading = index === 0 ? 'eager' : 'lazy';
  var mobilePos = entry.posMobile || entry.pos;
  var image = entry.image || s.cover;
  return '' +
    '<a class="strip" href="' + s.destinationUrl + '" data-proto-link data-id="' + s.id + '">' +
      '<img class="strip-img" src="' + image.src + '" alt="' + esc(image.alt || '') + '" loading="' + loading + '" decoding="async" ' +
        'style="object-position:' + entry.pos + ';" ' +
        'data-pos-desktop="' + entry.pos + '" data-pos-mobile="' + mobilePos + '">' +
      '<div class="strip-meta">' +
        '<h2 class="strip-title">' + (s.title || '') + '</h2>' +
        (sub ? '<p class="strip-sub">' + sub + '</p>' : '') +
      '</div>' +
      '<span class="strip-hint">VIEW PROJECT &#8599;</span>' +
    '</a>';
}

document.getElementById('strips').innerHTML = SEQUENCE.map(stripHTML).join('');

/* Mobile object-position overrides — applied via JS rather than a CSS
   media query per image, since only a couple of covers actually need a
   different crop at a taller mobile strip ratio. */
var mq = window.matchMedia('(max-width: 767px)');
function applyPositions() {
  document.querySelectorAll('.strip-img').forEach(function (img) {
    img.style.objectPosition = mq.matches ? img.dataset.posMobile : img.dataset.posDesktop;
  });
}
applyPositions();
mq.addEventListener('change', applyPositions);

/* Every /projects/[slug]/ destination now exists as a real route, so
   each strip's href (set from s.destinationUrl in stripHTML above) is
   left as-is — no override map, no click interception needed. */

/* Scrolling is native everywhere: the old synthetic wheel inertia
   (preventDefault + scrollBy/scrollTop in rAF) made the wheel feel
   hijacked and slow, so it's gone. */
</script>
</Base>
