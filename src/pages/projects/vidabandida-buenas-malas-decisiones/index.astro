---
import Base from '../../../layouts/Base.astro';
---
<Base>
<Fragment slot="head">
<title>VIDABANDIDA — Buenas Malas Decisiones — Art Direction by Charles Days</title>
<meta name="description" content="VIDABANDIDA — Buenas Malas Decisiones, a digital art intervention by Charles Days built around a new garment and the contradiction that gives it its name.">
<link rel="canonical" href="https://charlesdays.art/projects/vidabandida-buenas-malas-decisiones/">
<meta property="og:type" content="website">
<meta property="og:title" content="VIDABANDIDA — Buenas Malas Decisiones — Art Direction by Charles Days">
<meta property="og:description" content="VIDABANDIDA — Buenas Malas Decisiones, a digital art intervention by Charles Days built around a new garment and the contradiction that gives it its name.">
<meta property="og:url" content="https://charlesdays.art/projects/vidabandida-buenas-malas-decisiones/">
<meta property="og:image" content="https://charlesdays.art/images/stories/vidabandida-buenas-malas-decisiones/cover.jpg">
<meta property="og:image:alt" content="Hombre patinando frente a un muro oscuro, rodeado de una gran intervención circular caligráfica gris claro/blanca">
<style is:inline>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&family=Space+Grotesk:wght@500;700&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}
:root{
  --bg:#000;--text:#f5f2ed;--text-muted:#c7cbd6;
  /* Same warm bone editorial surface approved for every completed
     project-detail — reused verbatim, not a new value. */
  --surface-bg:#f3eee5;
  --surface-text:#211d19;
  --surface-text-muted:#5e574c;
--font-display:'Space Grotesk', sans-serif;}
html{background:var(--bg);}
html,body{color:var(--text);font-family:'DM Sans',sans-serif;overflow-x:hidden;}

/* ======================================================================
   OPENING FRAME PROTOTYPE — VIDABANDIDA — BUENAS MALAS DECISIONES only
   (data id/slug "vidabandida-buenas-malas-decisiones" — see stories.js).
   Independent file, same isolated-per-project pattern already
   established for every completed project-detail. Everything above
   this comment is the untouched cinematic-strip system. Everything
   below is scoped to this file and only ever activates for the
   'vidabandida-buenas-malas-decisiones' strip.

   FIRST PASS — STRUCTURAL ONLY, same as every completed project. Every
   piece of the shared interaction system below is reused EXACTLY as
   approved, not reinterpreted: FLIP continuity technique, two-movement
   timing, paper-over-black concept, bone surface color, fixed exit
   control + adaptive contrast + aura, inertia mechanism/constants,
   teardown, the 55vw desktop paper width, the raised resting position,
   the paper entrance slide, and the long editorial scroll cue. The
   body sequence renders this project's real stories.js content
   (context, role, all 3 supportingImages, full credits) in a plain,
   single-image-per-step composition with one credit spread near the
   end — no creative pairing/rhythm designed yet, same first-pass
   approach as every other project. The Opening anchor uses the same
   height-based sizing technique as the other projects, with a 3:2
   aspect ratio matching the approved teaser image's (cover.jpg) own
   native ratio (1400×933) — this project has no local strip-image
   override, so the strip/hero uses story.cover directly. */

.of-hero{
  position:fixed;z-index:150;
  object-fit:cover;pointer-events:none;
}
.of-hero.is-animating{
  transition:
    top .6s cubic-bezier(.22,1,.36,1),
    left .6s cubic-bezier(.22,1,.36,1),
    width .6s cubic-bezier(.22,1,.36,1),
    height .6s cubic-bezier(.22,1,.36,1),
    object-position .6s cubic-bezier(.22,1,.36,1);
}
.of-hero.is-settling{
  transition:
    top .6s cubic-bezier(.22,1,.36,1),
    left .6s cubic-bezier(.22,1,.36,1),
    width .6s cubic-bezier(.22,1,.36,1),
    height .6s cubic-bezier(.22,1,.36,1),
    object-position .6s cubic-bezier(.22,1,.36,1);
}

.of-frame{
  position:fixed;inset:0;z-index:152;
  display:flex;align-items:center;justify-content:space-between;
  gap:4vw;padding:0 6vw;
  transform:translateY(-2.4vh);
  opacity:0;pointer-events:none;
  transition:opacity .32s ease;
}
.of-frame.is-visible{opacity:1;}

.of-frame-text{max-width:min(26vw,380px);}
.of-frame-role{font-size:0.68rem;letter-spacing:0.24em;text-transform:uppercase;color:var(--text-muted);margin-bottom:1rem;text-shadow:0 1px 6px rgba(0,0,0,0.5);}
.of-frame-title{font-family:var(--font-display);font-weight:700;text-transform:uppercase;font-size:clamp(1.8rem,3.9vw,3.5rem);line-height:0.98;letter-spacing:-0.01em;color:var(--text);text-shadow:0 2px 16px rgba(0,0,0,0.45);}
.of-frame-year{margin-top:0.7rem;font-size:0.78rem;letter-spacing:0.18em;color:var(--text-muted);text-shadow:0 1px 6px rgba(0,0,0,0.5);}

.of-anchor{height:clamp(300px,58vh,600px);aspect-ratio:3/2;flex:0 0 auto;}

@media (prefers-reduced-motion:reduce){
  .of-frame{transition:opacity .01s linear;}
}

.of-scroll{
  position:fixed;inset:0;z-index:155;
  overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;
  overflow-anchor:none;
  opacity:0;pointer-events:none;transition:opacity .3s ease;
}
.of-scroll.is-active{opacity:1;pointer-events:auto;}

.of-spacer{height:calc(100svh - 34px);position:relative;}
@media (min-width:900px){
  /* Approved desktop opening interaction (same system as every other
     project): the paper begins substantially lower and the entrance
     animation (see #of-sequence.is-entering/.is-settling below) slides
     it up into this raised resting position — ~210px of real paper
     visible before any scroll input. */
  .of-spacer{height:calc(100svh - 210px);}
}

.of-sequence{width:min(92vw,1440px);margin:0 auto;background:var(--surface-bg);}
@media (min-width:1200px){
  .of-sequence{width:55vw;}
}

/* Base image rule — present in every completed project. Without
   display:block, an <img> defaults to display:inline, and margin:auto
   has no centering effect on inline boxes. */
.seq-img{display:block;width:100%;height:auto;}

/* Entrance slide (approved system, identical to every completed
   project): the paper itself starts ~120px below its raised resting
   position and animates up into it once, right as the project opens.
   Only ever toggled on desktop widths (see the JS trigger in
   openBuenasMalasDecisiones) — mobile/tablet never receive these
   classes. */
#of-sequence.is-entering{transform:translateY(120px);}
#of-sequence.is-settling{transform:translateY(0);transition:transform 1s cubic-bezier(.22,.61,.36,1);}

/* Opening-only "continues below" cue (approved system, identical to
   every completed project) — no text, no arrow, no icon: a long, thin,
   centered editorial line. Belongs to #of-scroll's own scrollable
   content (a child of .of-spacer, NOT fixed/sticky), positioned
   absolutely against that spacer so it scrolls away with the opening
   state the instant the user scrolls. 140px height — same .of-frame
   text values as every approved project, so the same ~168px gap and
   the same cap apply. */
.of-continue-cue{
  position:absolute;left:50%;bottom:14px;
  width:1px;height:140px;
  background:rgba(245,242,237,0.28);
  transform:translateX(-50%);
  opacity:0;pointer-events:none;
  transition:opacity .4s ease;
}
.of-continue-cue.is-visible{opacity:1;}
.of-continue-cue.is-breathing{animation:of-continue-drift 2.6s ease-in-out infinite;}
@keyframes of-continue-drift{
  0%,100%{transform:translateX(-50%) translateY(0);}
  50%{transform:translateX(-50%) translateY(6px);}
}
@media (prefers-reduced-motion:reduce){
  .of-continue-cue{transition:opacity .01s linear;}
  .of-continue-cue.is-breathing{animation:none;}
}

/* STEP 1/3 — plain single-image beats. First pass only — no creative
   pairing/rhythm decided yet. */
.bmd-image{max-width:900px;margin:0 auto;padding:1.2rem 1.4rem 2rem;}
.bmd-image .seq-img{max-width:480px;margin:0 auto;}
@media (min-width:900px){
  .bmd-image{padding:1.5rem 2.4rem 2.5rem;}
  .bmd-image .seq-img{max-width:560px;}
}

/* STEP 2 — brief project story (role + canonical context), standalone,
   same pattern already used for every other project's story beat. */
.bmd-story{max-width:620px;margin:0 auto;padding:2.5rem 1.4rem;}
.bmd-story-body{font-size:0.98rem;line-height:1.7;color:var(--surface-text);white-space:pre-line;font-weight:300;}
@media (min-width:900px){
  .bmd-story{padding:3rem 2.4rem;}
  .bmd-story-body{font-size:1.03rem;}
}

/* STEP 4 — detail-03 + full credits spread (Photography x2, Model x4),
   the final beat before the epilogue — same structural pattern as
   every other project's credit spread, built with a percentage gap and
   min-width:0 from the start (no viewport-relative gap introduced, so
   no later 55vw containment fix is needed here). */
.bmd-detail{
  max-width:1200px;margin:0 auto;padding:1.5rem 1.4rem;
  display:flex;flex-direction:column;gap:1.75rem;
}
.bmd-detail-credits{max-width:320px;}
.bmd-credit{margin-bottom:1rem;}
.bmd-credit:last-child{margin-bottom:0;}
.bmd-credit-role{display:block;font-size:0.62rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--surface-text-muted);margin-bottom:0.3rem;}
.bmd-credit-name{display:block;font-size:0.92rem;color:var(--surface-text);font-weight:300;}
.bmd-detail .seq-img{max-width:420px;margin:0 auto 0 0;}
@media (min-width:900px){
  .bmd-detail{padding:2.5rem 2.4rem;flex-direction:row-reverse;align-items:center;gap:4%;}
  .bmd-detail-credits{flex:0 0 auto;}
  .bmd-detail .seq-img{max-width:560px;margin:0;min-width:0;}
}

/* EPILOGUE — after detail-03/credits. This project's externalLinks is
   currently empty ([]), so no CTA is rendered — buildEpilogue() below
   already handles this conditionally (same function shape as every
   other project, nothing invented). Only the deliberate end-of-project
   Return renders here for now. */
.bmd-epilogue{max-width:640px;margin:0 auto;padding:2rem 1.4rem 6rem;}
.bmd-epilogue-kicker{font-size:0.66rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--surface-text-muted);margin-bottom:1rem;}
.bmd-epilogue-link{display:inline-block;margin-bottom:3rem;font-size:0.7rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--surface-text-muted);text-decoration:none;}
.bmd-epilogue-link:hover{color:var(--surface-text);}
.bmd-epilogue-return{
  display:inline-block;font-family:'DM Sans',sans-serif;
  font-size:0.9rem;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;
  color:var(--surface-text);text-decoration:none;
  padding:13px 2px;
}
.bmd-epilogue-return:hover{opacity:0.65;}
@media (min-width:900px){
  .bmd-epilogue{padding:2.5rem 2.4rem 7rem;}
}

/* Fixed exit — identical rules to every completed project's approved
   control (reused verbatim). ONLY TEXT: no background, gradient,
   shadow-halo, pseudo-element, or blur — only the approved subtle aura
   and the adaptive color swap. */
.of-exit{
  position:fixed;bottom:1.3rem;left:1.2rem;z-index:200;
  font-size:0.875rem;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;
  color:var(--text);text-decoration:none;opacity:0;pointer-events:none;
  background:none;box-shadow:none;filter:none;
  -webkit-backdrop-filter:none;backdrop-filter:none;outline:none;
  text-shadow:0 0 8px rgba(0,0,0,.4);
  transition:opacity .3s ease;
  padding:13px 14px;
  display:inline-block;
}
.of-exit::before,.of-exit::after{content:none;}
.of-exit.is-visible{opacity:.8;pointer-events:auto;}
.of-exit:hover,.of-exit:focus-visible{opacity:1;}
.of-exit.is-on-surface{color:var(--surface-text);}

@media (min-width:768px){
  .of-exit{bottom:1.6rem;left:2.4rem;}
}
</style>
</Fragment>
<main>
  <h1 class="sr-only">VIDABANDIDA — Buenas Malas Decisiones — Charles Days</h1>
</main>

<!-- Opening Frame prototype layers — inert until VIDABANDIDA — BUENAS
     MALAS DECISIONES is clicked -->
<div class="of-frame" id="of-frame">
  <div class="of-frame-text">
    <p class="of-frame-role" id="of-frame-role"></p>
    <h2 class="of-frame-title" id="of-frame-title"></h2>
    <p class="of-frame-year" id="of-frame-year"></p>
  </div>
  <div class="of-anchor" id="of-anchor"></div>
</div>

<a href="/projects/" class="of-exit" id="of-exit">&larr; PROJECTS</a>

<div class="of-scroll" id="of-scroll">
  <div class="of-spacer">
    <div class="of-continue-cue" id="of-continue-cue" aria-hidden="true"></div>
  </div>
  <div class="of-sequence" id="of-sequence"></div>
</div>

<script is:inline type="module">
/* Standalone visual prototype (Opening Frame pass) for VIDABANDIDA —
   BUENAS MALAS DECISIONES (data id/slug
   "vidabandida-buenas-malas-decisiones"). Reads the real entry directly
   from stories.js. Does not modify any other project's
   opening-frame-prototype file or art-direction-cinematic-strips-
   prototype.html — this file embeds its own copy of the strip list
   (same pattern already established by every other prototype), so it
   can be evaluated independently. Only the click behavior for the
   'vidabandida-buenas-malas-decisiones' strip differs; every other
   strip keeps today's no-op preventDefault. */
import { stories } from '/stories.js';

var byId = {};
stories.forEach(function (s) { byId[s.id] = s; });

function esc(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

/* ======================================================================
   VISUAL SEQUENCE — VIDABANDIDA — BUENAS MALAS DECISIONES only, FIRST
   PASS. Built from the real supportingImages array in stories.js,
   matched by filename fragment. Canonical `context`, `role`, and
   `credits` are used verbatim (HTML-escaped only), never rewritten.
   Presentation order below follows supportingImages' own stored order
   exactly (01→03) — no creative rhythm/pairing has been designed yet.
   ====================================================================== */
function findSupportingImage(story, fragment) {
  return story.supportingImages.filter(function (img) {
    return img.src.indexOf(fragment) !== -1;
  })[0];
}

function seqImg(image) {
  return '<img class="seq-img" src="' + image.src + '" alt="' + esc(image.alt || '') + '" loading="lazy" decoding="async">';
}

function bmdCredits(story) {
  var order = [];
  var byRole = {};
  story.credits.forEach(function (c) {
    if (!byRole[c.role]) { byRole[c.role] = []; order.push(c.role); }
    byRole[c.role].push(c.name);
  });
  return '<div class="bmd-detail-credits">' +
    order.map(function (role) {
      var names = byRole[role];
      var label = names.length > 1 ? role + 's' : role;
      return '<p class="bmd-credit">' +
        '<span class="bmd-credit-role">' + esc(label) + '</span>' +
        names.map(function (n) { return '<span class="bmd-credit-name">' + esc(n) + '</span>'; }).join('') +
      '</p>';
    }).join('') +
  '</div>';
}

function buildBuenasMalasDecisionesSequence(story) {
  var img01 = findSupportingImage(story, 'detail-01');
  var img02 = findSupportingImage(story, 'detail-02');
  var img03 = findSupportingImage(story, 'detail-03');
  var role = Array.isArray(story.role) ? story.role.join(', ') : '';

  return '' +
    /* STEP 1 — detail-01, portrait with the blue circular intervention. */
    '<section class="seq bmd-image">' + seqImg(img01) + '</section>' +

    /* STEP 2 — brief project story, standalone. */
    '<section class="seq bmd-story">' +
      '<p class="seq-kicker">' + esc(role) + '</p>' +
      '<p class="bmd-story-body">' + esc(story.context || '') + '</p>' +
    '</section>' +

    /* STEP 3 — detail-02, portrait with the red/orange circular
       intervention. */
    '<section class="seq bmd-image">' + seqImg(img02) + '</section>' +

    /* STEP 4 — detail-03 + full credits spread, the closing beat. */
    '<section class="seq bmd-detail">' + bmdCredits(story) + seqImg(img03) + '</section>' +

    buildEpilogue(story);
}

function buildEpilogue(story) {
  var reelLink = story.externalLinks && story.externalLinks[0];

  return '<section class="seq bmd-epilogue">' +
    (reelLink ?
      '<div>' +
        '<p class="bmd-epilogue-kicker">Related</p>' +
        '<a href="' + reelLink.url + '" target="_blank" rel="noopener noreferrer" class="bmd-epilogue-link">' + esc(reelLink.label) + '</a>' +
      '</div>'
      : '') +
    /* Real navigation back to the main PROJECTS page — this is
       the end-of-project exit, distinct from the persistent #of-exit
       control used mid-sequence (which still closes/resets in place). */
    '<a href=\"/projects/\" class=\"bmd-epilogue-return\" id=\"of-exit-end\">&larr; RETURN TO PROJECTS</a>' +
  '</section>';
}

document.getElementById('of-sequence').innerHTML = buildBuenasMalasDecisionesSequence(byId['vidabandida-buenas-malas-decisiones']);
openBuenasMalasDecisiones(byId['vidabandida-buenas-malas-decisiones']);

/* ======================================================================
   OPENING FRAME — VIDABANDIDA — BUENAS MALAS DECISIONES only. Same
   FLIP-continuity technique and two-movement timing already approved
   for every other project (reused unchanged). IMMERSIVE_CROP matches
   the already approved teaser crop for this project (50% 8%) — not a
   new placeholder invented for this pass. This crop keeps the upper
   area (model + circular intervention) intact, per the explicit visual
   note for this project.
   ====================================================================== */
var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var IMMERSIVE_CROP = '50% 8%'; // approved teaser crop for this project

var BEAT_MS = 130;    // full-frame pause between the two movements
var SETTLE_MS = 600;  // Movement 2 duration — matches .of-hero.is-settling
var TEXT_LEAD_MS = Math.round(SETTLE_MS * 2 / 3);
var PAPER_ENTER_MS = 1000; // matches #of-sequence.is-settling's transition-duration below

/* Paper entrance slide — approved system, identical to every completed
   project. Runs once, right as the paper fades in: starts 120px below
   the approved resting position, animates up into it, then both
   classes are cleared so .of-sequence is left with no transform at all
   — no residual effect on scroll/inertia. Skipped entirely below the
   900px desktop breakpoint used for the raised resting position
   itself. */
function animatePaperEntrance() {
  if (window.innerWidth < 900) return;
  var paperEl = document.getElementById('of-sequence');
  paperEl.classList.add('is-entering');
  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      paperEl.classList.add('is-settling');
      paperEl.classList.remove('is-entering');
    });
  });
  setTimeout(function () {
    paperEl.classList.remove('is-settling');
    showContinueCue();
  }, PAPER_ENTER_MS);
}

/* Opening-only "continues below" cue — approved system, identical to
   every completed project. Fades in once the paper entrance settles,
   then breathes a few px down and back. Belongs only to the opening
   state: as soon as real scroll input arrives it is faded out and
   disabled for the rest of that open session. */
function showContinueCue() {
  if (window.innerWidth < 900) return;
  var cueEl = document.getElementById('of-continue-cue');
  cueEl.classList.add('is-visible');
  cueEl.classList.add('is-breathing');
}

function hideContinueCue() {
  var cueEl = document.getElementById('of-continue-cue');
  cueEl.classList.remove('is-visible', 'is-breathing');
}

function openBuenasMalasDecisiones(story) {
  document.documentElement.style.overflow = 'hidden';
  document.body.style.overflow = 'hidden';
  document.getElementById('of-scroll').scrollTop = 0;

  var hero = document.createElement('img');
  hero.className = 'of-hero';
  hero.src = story.cover.src;
  hero.alt = '';
  hero.setAttribute('aria-hidden', 'true');
  document.body.appendChild(hero);

  var frameEl = document.getElementById('of-frame');
  var anchorEl = document.getElementById('of-anchor');
  var scrollEl = document.getElementById('of-scroll');
  var exitEl = document.getElementById('of-exit');

  document.getElementById('of-frame-title').textContent = story.title || '';
  document.getElementById('of-frame-year').textContent = story.year ? String(story.year) : '';
  document.getElementById('of-frame-role').textContent = Array.isArray(story.role) ? story.role.join(', ') : '';

  function settleImmersive() {
    hero.style.top = '0px';
    hero.style.left = '0px';
    hero.style.width = window.innerWidth + 'px';
    hero.style.height = window.innerHeight + 'px';
    hero.style.objectPosition = IMMERSIVE_CROP;
  }

  function settleToArtwork() {
    var r = anchorEl.getBoundingClientRect();
    hero.style.top = r.top + 'px';
    hero.style.left = r.left + 'px';
    hero.style.width = r.width + 'px';
    hero.style.height = r.height + 'px';
    hero.style.objectPosition = '50% 50%';
  }

  if (reduceMotion) {
    settleToArtwork();
    scrollEl.classList.add('is-active');
    frameEl.classList.add('is-visible');
    exitEl.classList.add('is-visible');
    showContinueCue();
    return;
  }

  settleImmersive();

  setTimeout(function () {
    hero.classList.add('is-settling');
    settleToArtwork();

    setTimeout(function () {
      scrollEl.classList.add('is-active');
      frameEl.classList.add('is-visible');
      exitEl.classList.add('is-visible');
      animatePaperEntrance();
    }, TEXT_LEAD_MS);
  }, BEAT_MS);

  /* Opening-only cue: the moment real scroll input arrives, fade it out
     and stop it from ever reappearing for the rest of this open
     session. */
  if (scrollEl._cueHideHandler) {
    scrollEl.removeEventListener('scroll', scrollEl._cueHideHandler);
  }
  var cueDismissed = false;
  scrollEl._cueHideHandler = function () {
    if (cueDismissed) return;
    if (scrollEl.scrollTop > 4) {
      cueDismissed = true;
      hideContinueCue();
      scrollEl.removeEventListener('scroll', scrollEl._cueHideHandler);
    }
  };
  scrollEl.addEventListener('scroll', scrollEl._cueHideHandler);

  if (scrollEl._exitContrastHandler) {
    scrollEl.removeEventListener('scroll', scrollEl._exitContrastHandler);
  }
  scrollEl._exitContrastHandler = function () {
    var spacer = document.querySelector('.of-spacer');
    var pastSpacer = scrollEl.scrollTop >= spacer.offsetHeight - 8;
    var exitRect = exitEl.getBoundingClientRect();
    var paperRect = document.getElementById('of-sequence').getBoundingClientRect();
    var overPaper = exitRect.left >= paperRect.left && exitRect.right <= paperRect.right;
    exitEl.classList.toggle('is-on-surface', pastSpacer && overPaper);
  };
  scrollEl.addEventListener('scroll', scrollEl._exitContrastHandler);
  scrollEl._exitContrastHandler();
}


/* Scrolling is native everywhere: the old synthetic wheel inertia
   (preventDefault + scrollBy/scrollTop in rAF) made the wheel feel
   hijacked and slow, so it's gone. */
</script>
</Base>
