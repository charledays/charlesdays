---
/* FILM & PHOTO — stills, campaigns and photography, hung as gallery walls.
   Each series is one row of photos at the same height and their own
   natural width (nothing cropped), so the mixed sizes read as one body of
   work instead of a grid of forced crops. Content comes straight from
   stories.js: every entry with discipline "film" and a series, in file
   order; the reel/post link (externalLinks[0]) is offered in the viewer. */
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import GalleryRow from '../../components/GalleryRow.astro';
import Viewer from '../../components/Viewer.astro';
import { stories } from '../../lib/media';
import '../../styles/gallery.css';

const SERIES = [
  { key: 'vidabandida', label: 'VIDABANDIDA', kicker: 'Universo en curso' },
  { key: 'days-off', label: 'DAYS OFF', kicker: 'Serie' },
  { key: 'lost-frames', label: 'LOST FRAMES', kicker: 'Serie' },
];

const rows = SERIES.map((s) => ({
  ...s,
  items: stories
    .filter((e) => e.discipline?.includes('film') && e.series === s.key && e.cover?.src)
    .map((e) => ({
      src: e.cover!.src,
      alt: e.cover!.alt || e.title || '',
      caption: e.title,
      meta: e.year,
      link: e.externalLinks?.[0]?.url,
      linkLabel: e.externalLinks?.[0]?.label,
    })),
})).filter((r) => r.items.length);
---
<Base>
  <PageHead
    slot="head"
    title="Film & Photo — Charles Days"
    description="Charles Days — film y fotografía: stills, campañas y series fotográficas."
    image="/images/wall/avirex.png"
    imageAlt="Fotograma de un proyecto de Film de Charles Days"
  />

  <main class="g-page">
    <header class="g-head g-wrap">
      <p class="g-kicker">Stills · Campañas · Fotografía</p>
      <h1 class="g-title">FILM &amp; PHOTO</h1>
      <nav class="g-index" aria-label="Series">
        {rows.map((r) => <a href={`#${r.key}`}>{r.label}<sup>{String(r.items.length).padStart(2, '0')}</sup></a>)}
      </nav>
    </header>

    {rows.map((r, i) => (
      <GalleryRow id={r.key} title={r.label} kicker={r.kicker} items={r.items} size={i === 0 ? 'lg' : 'md'} />
    ))}

    <footer class="g-foot g-wrap">
      <span>Charles Days · Film &amp; Photo</span>
      <span class="g-foot-links">
        <a class="g-link" href="/about/#contacto">Contacto</a>
        <a class="g-link" href="https://www.instagram.com/charlesdays.art" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
      </span>
    </footer>
  </main>

  <Viewer />
</Base>
