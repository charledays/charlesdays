---
import Base from '../../layouts/Base.astro';
---
<Base>
<Fragment slot="head">
<title>Film / Moving Image — Charles Days</title>
<meta name="description" content="Charles Days — Film y moving image: frames, campañas e imágenes en movimiento.">
<link rel="canonical" href="https://charlesdays.art/film/">
<meta property="og:type" content="website">
<meta property="og:title" content="Film / Moving Image — Charles Days">
<meta property="og:description" content="Charles Days — Film y moving image: frames, campañas e imágenes en movimiento.">
<meta property="og:url" content="https://charlesdays.art/film/">
<meta property="og:image" content="https://charlesdays.art/images/wall/avirex.png">
<meta property="og:image:alt" content="Fotograma de un proyecto de Film de Charles Days">
<style is:inline>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&family=Space+Grotesk:wght@500;700&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#000;--text:#f5f2ed;--text-muted:#9aa4c2;--ink-dark:#0f1d42;--hair:rgba(245,242,237,0.12);--font-display:'Space Grotesk', sans-serif;}
html{background:var(--bg);}
html,body{color:var(--text);font-family:'DM Sans',sans-serif;overflow-x:hidden;}

/* ===== intro ===== */
.film-page{padding-top:var(--nav-h);}
.film-intro{padding:3.6rem 1.2rem 2rem;}
.film-h1{font-family:var(--font-display);font-weight:700;font-size:clamp(2.2rem,9vw,3.4rem);letter-spacing:-0.01em;line-height:0.95;color:var(--text);}
.film-subtitle{margin-top:0.7rem;font-size:0.85rem;line-height:1.55;color:var(--text-muted);max-width:34ch;}
@media (min-width:768px){.film-intro{padding:5.5rem 2rem 2.6rem;}}

/* ===== mobile series index — editorial, not ecommerce pills =====
   Hidden at desktop widths: desktop shows every section in full, so the
   quick-jump index is a mobile-only affordance against long scroll. */
.film-index{display:flex;gap:1.5rem;padding:0 1.2rem 2rem;overflow-x:auto;scrollbar-width:none;border-bottom:1px solid var(--hair);}
.film-index::-webkit-scrollbar{display:none;}
.film-index-btn{background:none;border:none;padding:0.35rem 0 0.6rem;font-family:'DM Sans',sans-serif;font-size:0.62rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--text-muted);cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent;transition:color .2s ease,border-color .2s ease;}
.film-index-btn.is-active{color:var(--text);border-color:var(--text);}
.film-index-btn:hover{color:var(--text);}
.film-index-btn:focus-visible{outline:2px solid rgba(255,255,255,0.9);outline-offset:2px;}
@media (min-width:768px){.film-index{display:none;}}

/* ===== series sections ===== */
.film-series{padding:0 1.2rem 3.2rem;}
.film-series-title{font-family:var(--font-display);font-weight:700;font-size:1.25rem;letter-spacing:-0.005em;color:var(--text);margin-bottom:1.2rem;}
@media (min-width:768px){
  .film-series{padding:0 2rem 4.5rem;}
  .film-series-title{font-size:1.55rem;margin-bottom:1.5rem;}
}

.film-empty{font-size:0.68rem;letter-spacing:0.05em;color:var(--text-muted);padding-top:0.2rem;}

.film-grid{display:grid;grid-template-columns:1fr;gap:2.4rem;}
@media (min-width:768px){.film-grid{grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1.4rem;}}
@media (min-width:1200px){.film-grid{gap:1.8rem;}}

/* Lost Frames, Vidabandida and Days Off, mobile only: 2-column editorial
   grid. Desktop is untouched (the >=768px rule above still applies to
   every series, since this override sits under max-width:767px). */
@media (max-width:767px){
  .film-grid[data-series-grid="lost-frames"],
  .film-grid[data-series-grid="vidabandida"],
  .film-grid[data-series-grid="days-off"]{grid-template-columns:1fr 1fr;gap:1.8rem 0.8rem;}
  .film-grid[data-series-grid="lost-frames"] .film-card-meta,
  .film-grid[data-series-grid="vidabandida"] .film-card-meta,
  .film-grid[data-series-grid="days-off"] .film-card-meta{flex-direction:column;align-items:flex-start;gap:0.2rem;}
}

.film-card{display:block;text-decoration:none;color:inherit;}
.film-card-frame{position:relative;overflow:hidden;background:#0a0a0a;aspect-ratio:4/5;}
.film-card-frame img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s ease;}
a.film-card:hover .film-card-frame img,a.film-card:focus-visible .film-card-frame img{transform:scale(1.035);}
a.film-card:focus-visible{outline:2px solid rgba(255,255,255,0.9);outline-offset:3px;}

/* INTERNAZIONALE STATEMENT only: the canonical still has faint white
   margins baked into its left/right edges. object-fit:cover alone doesn't
   remove them here (this image's aspect ratio makes the card crop
   top/bottom, not sides), so a small scoped zoom hides them without
   touching the source file or any other Film card. Values chosen from the
   actual image so the additional crop only trims empty wall/table space
   around the subject, not the person, artwork, or tablet. */
.film-card[data-id="internazionale-statement"] .film-card-frame img{transform:scale(1.14);}
a.film-card[data-id="internazionale-statement"]:hover .film-card-frame img,
a.film-card[data-id="internazionale-statement"]:focus-visible .film-card-frame img{transform:scale(1.18);}

.film-card-overlay{position:absolute;inset:0;display:flex;align-items:flex-end;padding:0.8rem;background:linear-gradient(transparent 55%,rgba(0,0,0,0.55));opacity:0;transition:opacity .3s ease;}
a.film-card:hover .film-card-overlay,a.film-card:focus-visible .film-card-overlay{opacity:1;}
.film-card-overlay-text{font-size:0.6rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--text);}

.film-card-meta{margin-top:0.65rem;display:flex;justify-content:space-between;align-items:baseline;gap:0.6rem;}
.film-card-title{font-family:var(--font-display);font-weight:500;font-size:0.82rem;letter-spacing:0;color:var(--text);}
.film-card-year{font-size:0.62rem;color:var(--text-muted);letter-spacing:0.06em;flex:0 0 auto;}

.film-viewall{display:inline-block;margin-top:1.1rem;font-size:0.62rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--text);text-decoration:none;border-bottom:1px solid rgba(245,242,237,0.4);padding-bottom:0.15rem;}
.film-viewall:hover{border-color:var(--text);}
.film-viewall:focus-visible{outline:2px solid rgba(255,255,255,0.9);outline-offset:3px;}
.film-viewall[hidden]{display:none;}
@media (min-width:768px){.film-viewall{display:none;}}

@media (prefers-reduced-motion: reduce){
  .film-card-frame img{transition:none;}
  a.film-card:hover .film-card-frame img,a.film-card:focus-visible .film-card-frame img{transform:none;}
  /* Re-apply the INTERNAZIONALE STATEMENT crop: it corrects framing, it
     isn't a hover animation, so it must persist under reduced motion too. */
  .film-card[data-id="internazionale-statement"] .film-card-frame img{transform:scale(1.14);}
  .film-card-overlay{transition:none;}
}
</style>
</Fragment>
<main class="film-page">
  <header class="film-intro">
    <h1 class="film-h1">FILM</h1>
    <p class="film-subtitle">Frames, campaigns and moving images.</p>
  </header>

  <div class="film-index" role="group" aria-label="Filtrar Film por serie">
    <button type="button" class="film-index-btn is-active" data-filter="all" aria-pressed="true">ALL</button>
    <button type="button" class="film-index-btn" data-filter="vidabandida" aria-pressed="false">VIDABANDIDA</button>
    <button type="button" class="film-index-btn" data-filter="days-off" aria-pressed="false">DAYS OFF</button>
    <button type="button" class="film-index-btn" data-filter="lost-frames" aria-pressed="false">LOST FRAMES</button>
  </div>

  <div id="filmContent">
    <section class="film-series" data-series="vidabandida" aria-labelledby="vidabandida-heading">
      <h2 id="vidabandida-heading" class="film-series-title">VIDABANDIDA</h2>
      <div class="film-grid" data-series-grid="vidabandida"></div>
      <a href="#" class="film-viewall" data-series-viewall="vidabandida" hidden>View all →</a>
    </section>

    <section class="film-series" data-series="days-off" aria-labelledby="days-off-heading">
      <h2 id="days-off-heading" class="film-series-title">DAYS OFF</h2>
      <div class="film-grid" data-series-grid="days-off"></div>
      <a href="#" class="film-viewall" data-series-viewall="days-off" hidden>View all →</a>
    </section>

    <section class="film-series" data-series="lost-frames" aria-labelledby="lost-frames-heading">
      <h2 id="lost-frames-heading" class="film-series-title">LOST FRAMES</h2>
      <div class="film-grid" data-series-grid="lost-frames"></div>
      <a href="#" class="film-viewall" data-series-viewall="lost-frames" hidden>View all →</a>
    </section>
  </div>
</main>

<script is:inline type="module">
/* Film page: reads Film entries directly out of the shared stories.js
   content model (discipline: ["film"]) — no second/parallel schema.
   Currently renders empty states everywhere because no Film entries are
   approved yet (see CONTENT_PENDING.md "Film" / PENDING_CONTENT.film in
   stories.js). Adding a real, approved entry to `stories` is the only
   change needed to populate this page — no markup/behavior changes. */
import { stories } from '/stories.js';

var SERIES = [
  { key: 'vidabandida', label: 'VIDABANDIDA' },
  { key: 'days-off', label: 'DAYS OFF' },
  { key: 'lost-frames', label: 'LOST FRAMES' }
];
var MOBILE_PREVIEW_COUNT = { 'lost-frames': 4, 'vidabandida': 4, 'days-off': 4 };

var filmEntries = stories.filter(function (s) {
  return Array.isArray(s.discipline) && s.discipline.indexOf('film') !== -1;
});

var bySeries = {};
SERIES.forEach(function (s) { bySeries[s.key] = []; });
filmEntries.forEach(function (entry) {
  if (entry.series && bySeries[entry.series]) {
    bySeries[entry.series].push(entry);
  }
});

var activeFilter = 'all';
var mq = window.matchMedia('(max-width: 767px)');

function watchLink(entry) {
  if (!entry.externalLinks || !entry.externalLinks.length) return null;
  var link = entry.externalLinks[0];
  return link && link.url ? link : null;
}

function cardMarkup(entry) {
  var link = watchLink(entry);
  var titleText = entry.title || '';
  var yearText = entry.year || '';
  var altText = (entry.cover && entry.cover.alt) || '';
  var src = entry.cover && entry.cover.src ? entry.cover.src : '';

  var overlay = link
    ? '<div class="film-card-overlay"><span class="film-card-overlay-text">' + (link.label || 'WATCH') + ' ↗</span></div>'
    : '';

  var frame = '<div class="film-card-frame">' +
    '<img src="' + src + '" alt="' + altText + '" loading="lazy" decoding="async">' +
    overlay +
    '</div>';

  var meta = '<div class="film-card-meta">' +
    '<span class="film-card-title">' + titleText + '</span>' +
    (yearText ? '<span class="film-card-year">' + yearText + '</span>' : '') +
    '</div>';

  if (link) {
    return '<a class="film-card" data-id="' + entry.id + '" href="' + link.url + '" target="_blank" rel="noopener noreferrer">' + frame + meta + '</a>';
  }
  return '<div class="film-card" data-id="' + entry.id + '">' + frame + meta + '</div>';
}

function setActive(key) {
  activeFilter = key;
  document.querySelectorAll('.film-index-btn').forEach(function (b) {
    var isActive = b.getAttribute('data-filter') === key;
    b.classList.toggle('is-active', isActive);
    b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
  });
  render();
}

function render() {
  var isMobile = mq.matches;

  SERIES.forEach(function (s) {
    var section = document.querySelector('.film-series[data-series="' + s.key + '"]');
    if (!section) return;
    var grid = section.querySelector('[data-series-grid]');
    var viewAll = section.querySelector('[data-series-viewall]');
    var entries = bySeries[s.key];

    var visible = activeFilter === 'all' || activeFilter === s.key;
    section.hidden = !visible;
    if (!visible) return;

    var previewCount = MOBILE_PREVIEW_COUNT[s.key] || 3;
    var isPreview = isMobile && activeFilter === 'all';
    var toRender = isPreview ? entries.slice(0, previewCount) : entries;

    grid.innerHTML = entries.length
      ? toRender.map(cardMarkup).join('')
      : '<p class="film-empty">Stills pending.</p>';

    if (viewAll) {
      viewAll.hidden = !(isPreview && entries.length > previewCount);
    }
  });
}

document.querySelectorAll('.film-index-btn').forEach(function (btn) {
  btn.addEventListener('click', function () { setActive(btn.getAttribute('data-filter')); });
});

document.querySelectorAll('[data-series-viewall]').forEach(function (link) {
  link.addEventListener('click', function (e) {
    e.preventDefault();
    setActive(link.getAttribute('data-series-viewall'));
  });
});

/* render() only depends on mq.matches (width), but a plain 'resize'
   listener also fires on mobile Safari when its URL bar collapses/expands
   during scroll — a HEIGHT-only change. That was re-triggering render()'s
   destructive innerHTML rebuild (new <img> elements, losing whatever was
   already decoded/painted) mid-scroll, which is what produced the
   black-flash/flicker. Listening to the media query's own 'change' event
   instead only fires on an actual width crossing (e.g. rotation). */
mq.addEventListener('change', render);

render();

/* Scrolling is native everywhere: the old synthetic wheel inertia
   (preventDefault + scrollBy/scrollTop in rAF) made the wheel feel
   hijacked and slow, so it's gone. */
</script>
</Base>
